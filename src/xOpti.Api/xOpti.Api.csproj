<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>xOpti.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local development settings may hold a connection string; never publish
         them into a container image or deployment artifact. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <None Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\xOpti.Application\xOpti.Application.csproj" />
    <ProjectReference Include="..\xOpti.Domain\xOpti.Domain.csproj" />
    <ProjectReference Include="..\xOpti.Infrastructure\xOpti.Infrastructure.csproj" />
  </ItemGroup>

</Project>
