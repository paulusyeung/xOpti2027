{
  "Logging": {
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "JsonWriterOptions": {
          "Indented": false
        },
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffzzz",
        "UseUtcTimestamp": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "XOptiDatabase": ""
  },
  "XOptiApi": {
    "FileStorageRoot": "/var/lib/xopti/files",
    "SessionIdle": "00:20:00",
    "LockoutWindow": "00:15:00",
    "IdempotencyRetention": "24:00:00",
    "SessionCookieName": "xopti.session",
    "FontDirectories": [
      "/usr/share/xopti/fonts"
    ],
    "MaterializedViewRefreshStatements": [
      "SELECT 1 /* example: replace with REFRESH MATERIALIZED VIEW analytics... */"
    ],
    "JobsEnabled": false
  }
}