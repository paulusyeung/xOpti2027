        ofx_OfbkIsOpen = OfbkIsOpen(s_nOfbkId)
    End If
#End If
End Function




'------------------------------------------------------------------------------
' Function: ofx_OfbkGetColumnValue
'
' Purpose:  Get the specified column value from the OfficeBook database for
'           the Nth (specified by nIndex) person in the list of selected people.
'
' Params:   nIndex      (I) The sequential index into the "selected" list
'           sColumnName (I) One of the column names above
'
' Returns:  The String value of the column (even if it is a number).
'
' Notes:    You should only use this function after a successful OfbkMainDlg()
'           call, it cannot be used to get a value for a particular PeopleID.
'
' See also: ofx_OfbkMainDialog() to allow user to select people,
'           ofx_OfbkGetColumnValueFromID() to get a value for a particular PeopleID.
'------------------------------------------------------------------------------
Public Function ofx_OfbkGetColumnValue(nIndex As Long, sColumnName As String) As String
    'no error handling!

#If Win32 Then
    ofx_OfbkGetColumnValue = s_ofbk.GetColumnValue(nIndex, sColumnName)
#Else
    Dim sBuf As String
    Dim nLen As Integer
    
    If (sColumnName = "Keywords" Or sColumnName = "Notes") Then
        'Need to get the buffer size
        nLen = OfbkGetColumnValue(s_nOfbkId, nIndex, sColumnName, sBuf, 0)
        nLen = (nLen * -1)
        If (nLen < 255) Then nLen = 255
    Else
        nLen = 255      '255 is the max for all other columns
    End If
    sBuf = String$(nLen + 1, 0)
    nLen = OfbkGetColumnValue(s_nOfbkId, nIndex, sColumnName, sBuf, nLen)
    If (nLen > 0) Then
        ofx_OfbkGetColumnValue = Left$(sBuf, nLen)
    ElseIf (0 = nLen) Then
        ofx_OfbkGetColumnValue = ""
    Else
        'some sort of error
        If (nLen = ERR_NOOPENDATABSE) Then
#If VB3 Then
            MsgBox sOfbkErrNoOpenDatabase
#Else
            Err.Raise ERR_NOOPENDATABSE, sOfficeBookErrSource, sOfbkErrNoOpenDatabase
#End If
        End If
    End If
#End If


End Function



'------------------------------------------------------------------------------
' Function: ofx_OfbkGetColumnValueFromID
'
' Purpose:  This function gets a value for ANY valid person in the database (based on PeopleID).
'
' Params:   nPeopleID   (I) The PeopleID
'           sColumnName (I) One of the column names above
'
' Returns:  The String value of the column (even if it is a number)
'------------------------------------------------------------------------------
Public Function ofx_OfbkGetColumnValueFromID(nPeopleID As Long, sColumnName As String) As String
    'no error handling!

    If (ofx_OfbkIsOpen()) Then
    
#If Win32 Then
        ofx_OfbkGetColumnValueFromID = s_ofbk.GetColumnValueFromID(nPeopleID, sColumnName)
#Else
        Dim sBuf As String
        Dim nLen As Integer
        
        If (sColumnName = "Keywords" Or sColumnName = "Notes") Then
            'Need to get the buffer size
            nLen = OfbkGetColumnValueFromID(s_nOfbkId, nPeopleID, sColumnName, sBuf, 0)
            nLen = (nLen * -1)
            If (nLen < 255) Then nLen = 255
        Else
            nLen = 255      '255 is the max for all other columns
        End If
        sBuf = String$(nLen + 1, 0)
        nLen = OfbkGetColumnValueFromID(s_nOfbkId, nPeopleID, sColumnName, sBuf, 1024)
        If (nLen > 0) Then
            ofx_OfbkGetColumnValueFromID = Left$(sBuf, nLen)
        ElseIf (0 = nLen) Then
            ofx_OfbkGetColumnValueFromID = ""
        Else
            'some sort of error
            If (nLen = ERR_NOOPENDATABSE) Then
#If VB3 Then
                MsgBox sOfbkErrNoOpenDatabase
#Else
                Err.Raise ERR_NOOPENDATABSE, sOfficeBookErrSource, sOfbkErrNoOpenDatabase
#End If
            End If
        End If
#End If

    End If


End Function



