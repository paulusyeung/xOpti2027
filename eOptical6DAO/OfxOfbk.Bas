'------------------------------------------------------------------------------
' Function: ofx_OfbkGetSelectedPeople
'
' Purpose:  Get a list of the currently selected people.
'
' Params:   nPeopleID   (O) Array of people IDs
'
' Returns:  True if at least one person successfully selected, else False.
'
' Notes:    You should only use this function after a successful ofx_OfbkMainDialog()
'           call, it cannot be used to get a value for a particular PeopleID.
'
' See also: ofx_OfbkMainDialog() to allow user to select people,
'           ofx_OfbkGetColumnValueFromID() to get a value for a particular PeopleID.
'------------------------------------------------------------------------------
Function ofx_OfbkGetSelectedPeople(nPeopleID() As Long) As Boolean
    On Error GoTo ofx_OfbkGetSelectedPeople_Err
    
    ofx_WaitCursor True
    
    If (ofx_OfbkIsOpen()) Then
        
        Dim i As Long
        Dim nId As Long
        Dim nRecordCount As Integer
        
        nRecordCount = ofx_OfbkGetRecordCount()
        If (nRecordCount > 0) Then
        
            ReDim nPeopleID(0 To nRecordCount - 1)
            For i = 1 To nRecordCount
                nId = CLng(Val(ofx_OfbkGetColumnValue(i, ofbkPeopleID)))
                nPeopleID(i - 1) = nId
            Next
            ofx_OfbkGetSelectedPeople = True
        End If
    
    End If
    
ofx_OfbkGetSelectedPeople_Exit:
    ofx_WaitCursor False
    Exit Function
ofx_OfbkGetSelectedPeople_Err:
    Call ofx_GenericError("ofx_OfbkGetSelectedPeople()", Err)
    Resume ofx_OfbkGetSelectedPeople_Exit
End Function



'------------------------------------------------------------------------------
' Function: ofx_OfbkFillList
'
' Purpose:  Fill a combo box or list control with the specified column from the
'           OfficeBook database for the list of selected people.
'
' Params:   list        (I) Either a ListBox or ComboBox
'           sColumnName (I) The column to use to fill the list
'           bClearFirst (I) If True, the list is cleared
'
' Returns:  True on success, else False.
'
' Example:  If(ofx_OfbkDoMainDialog(True)) Then
'               ofx_OfbkFillList List1, ofbkDisplayName, True
'           End If
'------------------------------------------------------------------------------
Function ofx_OfbkFillList(list As Control, sColumnName As String, bClearFirst As Boolean) As Boolean
    On Error GoTo ofx_OfbkFillList_Error
    
    Dim nDummy As Integer
    
    ofx_WaitCursor True
    
    If (bClearFirst) Then list.Clear
    
    If (ofx_OfbkIsOpen()) Then
        
        Dim i As Long
        Dim nId As Long
        Dim sData As String
        Dim nRecordCount As Long
        
        nRecordCount = ofx_OfbkGetRecordCount()
        If (nRecordCount > 0) Then
            
            For i = 1 To nRecordCount
                nId = CLng(Val(ofx_OfbkGetColumnValue(i, ofbkPeopleID)))
                sData = ofx_OfbkGetColumnValue(i, sColumnName)
                nDummy = ofx_ListBoxAddString(list, sData, nId)
            Next
            
            ofx_OfbkFillList = True
        End If
    
    
    End If
   
    
ofx_OfbkFillList_Exit:
    ofx_WaitCursor False
    Exit Function
ofx_OfbkFillList_Error:
    Call ofx_GenericError("ofx_OfbkFillList()", Err)
    Resume ofx_OfbkFillList_Exit
End Function







