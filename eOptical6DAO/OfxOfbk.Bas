'------------------------------------------------------------------------------
' Function: ofbk__createInstance
'
' Purpose:  Create an instance of OfficeBook.
'
' Returns:  True if created, else False.
'
' Notes:    Helper function for platform compatability
'------------------------------------------------------------------------------
Private Function ofbk__createInstance(hWnd As Long, sConnect As String) As Boolean
    On Error GoTo ofbk__createInstance_Error
    
    If (ofx_OfbkIsOpen()) Then
        ofbk__createInstance = True
    Else
          
        'if the connection string is empty and this is the first time
        'then Office Book will throw an error without a connection string
        If (0 = Len(sConnect)) Then
            sConnect = ofbk__getDefaultConnect()
        End If
    
#If Win32 Then
        'Only create ONCE
        If (s_ofbk Is Nothing) Then
            Set s_ofbk = CreateObject(idsOfficeBookProgID)
        End If
        
        If (Not (s_ofbk.IsOpen)) Then
            s_ofbk.Connect = sConnect
        End If
        
        s_ofbk.hWndParent = hWnd
        s_ofbk.Appname = App.ProductName
        
        ofbk__createInstance = (Not (s_ofbk Is Nothing))
#Else
        'Only one instance at a time
        If (0 = s_nOfbkId) Then
            s_nOfbkId = OfbkOpen()
        Else
            sConnect = ofx_OfbkGetConnect()
        End If
        
        Dim nDummy As Integer
        If (s_nOfbkId) Then nDummy = OfbkSetParent(s_nOfbkId, hWnd)
        
        s_sDefaultParams = tagConnect & "=" & sConnect & tagSep
        s_sDefaultParams = s_sDefaultParams & tagAppName & "=" & App.Title & tagSep
        
        ofbk__createInstance = (s_nOfbkId > 0)
    
#End If     'Win16 part

    End If

ofbk__createInstance_Exit:
    Exit Function
ofbk__createInstance_Error:
    Call ofx_GenericError("OfxOfficeBook::ofbk__createInstance()", Err)
    
#If Win32 Then
    Set s_ofbk = Nothing
#Else
    ofx_OfbkUninitialize
#End If
    Resume ofbk__createInstance_Exit
End Function



'------------------------------------------------------------------------------
' Function: ofbk__mainDialog
'
' Purpose:  Present the OfficeBook "Main" dialog.
'
' Params:   bInsertEnabled  (I) True if the Insert button should be enabled
'
' Returns:  True if Insert was clicked.
'
' Notes:    Helper function for platform compatability
'------------------------------------------------------------------------------
Private Function ofbk__mainDialog(ByVal bInsertEnabled As Boolean) As Boolean
    On Error GoTo ofbk__mainDialog_Err
    
    If (ofbk__isCreated()) Then

#If Win32 Then

        s_ofbk.InsertEnabled = bInsertEnabled
        'Only return TRUE if the user clicked the insert button
        If (s_ofbk.DoMainDialog()) Then
            ofbk__mainDialog = CBool(s_ofbk.InsertClicked)
        End If
#Else
        Dim sParams As String
        sParams = s_sDefaultParams
        If (bInsertEnabled) Then
            'in the .DLL interface, to get the Insert button enabled, set "InsertToDocText= <something>"
            sParams = sParams & tagInsertToDocText & "=Insert" & tagSep
        End If
        
        'show the main dialog
        If (OfbkMainDlg(s_nOfbkId, sParams)) Then
            ofbk__mainDialog = True
        End If

#End If

    End If
    
ofbk__mainDialog_Exit:
    On Error Resume Next
    Exit Function
ofbk__mainDialog_Err:
    MsgBox Error
    Resume ofbk__mainDialog_Exit
End Function



'------------------------------------------------------------------------------
' Function: ofbk__getDefaultConnect
'
' Purpose:  Get the current database connection string from the 1st open database.
'
' Returns:  A string that may be a good connect string
'
' Notes:    Helper function to get the current connect string from the first open database
'------------------------------------------------------------------------------
Private Function ofbk__getDefaultConnect() As String
    On Error Resume Next
    
    Dim sConnect As String
    
#If Not VB3 Then
    Const sJetPrefix As String = "ODBC;Driver={Microsoft Access Driver (*.mdb)};DBQ="
    Const sSqlPrefix As String = "ODBC;Driver={SQL Server};DATABASE="
    
    Dim db As CDatabaseHolder
    Set db = GetDB()
    
    If (Not (db Is Nothing)) Then
        
        Select Case db.DatabaseType
            Case dbHolderTypeJet
                sConnect = sJetPrefix & db.Database & ";UID=" & db.UserName & ";PWD=" & db.Password
            Case dbHolderTypeODBC
                sConnect = db.Connect
            Case dbHolderTypeRDO
                sConnect = db.Connect
            Case dbHolderTypeVBSQL
                sConnect = sSqlPrefix & db.Database & ";UID=" & db.UserName & ";PWD=" & db.Password & ";SERVER=" & db.Server
        End Select
    End If
#End If
    
    'Check the Registry/INI
    If (0 = Len(sConnect)) Then
        sConnect = ofx_ProfileGetString("Office Book", "Connect", "")
    End If
    
    ofbk__getDefaultConnect = sConnect

End Function



'------------------------------------------------------------------------------
' Function: ofbk__editRecordDlg
'
' Purpose:  Present the OfficeBook "Edit" dialog.
'
' Params:   nPeopleID   (I) The ID to 'edit'
'
' Returns:  True if Insert was clicked, else False.
'
' Notes:    Helper function for platform compatability
'------------------------------------------------------------------------------
Private Function ofbk__editRecordDlg(nPeopleID As Long) As Boolean
    'No error handling
    If (ofbk__isCreated()) Then
#If Win32 Then
        'Only return TRUE if the user clicked the insert button
        ofbk__editRecordDlg = s_ofbk.EditRecordDialog(nPeopleID)
#Else
        Dim sParams As String
        sParams = s_sDefaultParams
        ofbk__editRecordDlg = OfbkEditRecordDlg(s_nOfbkId, sParams, nPeopleID)
#End If
    Else
        #If VB3 Then
            MsgBox sOfbkErrNoOpenDatabase
        #Else
            Err.Raise 1001, sOfficeBookErrSource, sOfbkErrNoOpenDatabase
        #End If
    End If
End Function



