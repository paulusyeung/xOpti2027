Attribute VB_Name = "OfxOfficeBook"
'------------------------------------------------------------------------------
' Module:   Ofx - OfficeBook
'
' Purpose:  Interface to OfficeBook contact manager.
'
'           Functions in this Module:
'
'           ofx_OfbkInitialize()            Initialize OfficeBook
'           ofx_OfbkUninitialize()          Uninitialize OfficeBook
'
'           ofx_OfbkMainDialog()            Bring up main OfficeBook dialog
'           ofx_OfbkEditRecordDlg()         Bring up contact edit dialog
'           ofx_OfbkNewRecordDlg()          Bring up new contact dialog
'
'           ofx_OfbkIsOpen()                Determine if OfficeBook is open
'           ofx_OfbkGetConnect()            Get the database connection string
'           ofx_OfbkGetDSN()                Get database connection DSN
'           ofx_OfbkGetUID()                Get database connection User ID
'           ofx_OfbkGetAddressTabSelected() Get currently selected tab on main form
'
'           ofx_OfbkGetRecordCount()        Get number of people currently selected
'           ofx_OfbkGetColumnValue()        Get a datum about specified person from
'                                           list of people currently selected
'
'           ofx_OfbkGetColumnValueFromID()  Get a column value Absolute
'
'           ofx_OfbkGetSelectedPeople()     Get the ID's of currently selected people
'           ofx_OfbkFillList()              Fill a list or combo box with data about
'                                           list of people currently selected
'
' Notes:    The 16-bit interface is .DLL based, NOT an Object interface.
'           This module's implementation is based on the assumption that a user
'           will only have ONE instance of office book at any one time
'
' Examples: Display the find dialog (Main) and put the results into a list:
'
'           If (ofx_OfbkMainDialog(True)) Then
'               ofx_OfbkFillList Me.List1, ofbkDisplayName, True
'           End If
'
'           Let the user add a new record to the database, then add it to a listbox.
'           Note that the last argument to ofx_OfbkFillList is FALSE, (Don't clear the list):
'
'           If (ofx_OfbkNewRecordDlg()) Then
'               ofx_OfbkFillList Me.List1, ofbkDisplayName, False
'               ofx_ListBoxSelectString Me.List1, "Reid, Ryan"
'           End If
'
'           Edit a record that is in a list box, then replace the DisplayName with the new one:
'
'           Private Sub List1_DblClick()
'               Dim nPeopleID As Long
'               nPeopleID = ofx_ListBoxGetItemData(List1)
'               ofx_OfbkEditRecordDlg nPeopleID
'               Dim sDisplayName As String
'
'               ofx_ListBoxReplaceString List1, List1.ListIndex, ofx_OfbkGetColumnValueFromID(nPeopleID, ofbkDisplayName)
'           End Sub
'------------------------------------------------------------------------------

Option Explicit
