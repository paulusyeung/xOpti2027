Declare Function OfbkIsOpen Lib "OFBKLIB.DLL" (ByVal nId As Integer) As Integer

'----- The usefulness of this function is only seen in the 16bit world,
'----- if another instance of Office Book is running, then this function
'----- will get the connection string from that instance (actually from the FIRST instance of office book created)

Declare Function OfbkGetCurrentConnect Lib "OFBKLIB.DLL" (ByVal lpszConnectBuf As String, ByVal nBufSize As Integer) As Integer


'----- Parent window is required for the insert button

Declare Function OfbkSetParent Lib "OFBKLIB.DLL" (ByVal nId As Integer, ByVal hWndParent As Integer) As Integer

'----- For record based support

Declare Function OfbkGetColumnValueFromID Lib "OFBKLIB.DLL" (ByVal nId As Integer, ByVal lPeopleID As Long, ByVal lpszColumnName As String, ByVal lpszBuf As String, ByVal nBufSize As Integer) As Integer

#End If

'------------------------------------------------------------------------------
' Function: ofx_OfbkInitialize
'
' Purpose:  Initialize OfficeBook.
'
' Params:   hWnd        (I) Parent window
'           sConnect    (I) Database connection string
'
' Returns:  TRUE on success, else FALSE.
'
' Notes:    Should be the first function called
'
' See also: ofx_OfbkUninitialize
'------------------------------------------------------------------------------
Public Function ofx_OfbkInitialize(hWnd As Long, sConnect As String) As Boolean
    ofx_OfbkInitialize = ofbk__createInstance(hWnd, sConnect)
End Function



'------------------------------------------------------------------------------
' Sub:      ofx_OfbkUninitialize
'
' Purpose:  Cleanup OfficeBook when done.
'
' See also: ofx_OfbkInitialize
'------------------------------------------------------------------------------
Public Sub ofx_OfbkUninitialize()
#If Win32 Then
    Set s_ofbk = Nothing
#Else
    Dim rc As Integer
    If (s_nOfbkId) Then
        rc = OfbkClose(s_nOfbkId)
        s_nOfbkId = 0
    End If
#End If
End Sub






'------------------------------------------------------------------------------
' Function: ofx_OfbkMainDialog
'
' Purpose:  Displays the OfficeBook "Main" or Find dialog.
'
' Params:   hWnd            (I) The parent window handle (should not be null)
'           bInsertEnabled  (I) Enable the "Insert" button
'           sConnect        (I) The connection string
'
' Returns:  TRUE if Insert button clicked, else false.
'------------------------------------------------------------------------------
Function ofx_OfbkMainDialog(ByVal bInsertEnabled As Integer) As Boolean
    On Error GoTo ofx_OfbkDoMainDialog_Error
    
    If (Not (ofx_OfbkIsOpen())) Then
        Dim sConnect As String
        If (Not (ofx_OfbkInitialize(ofx_GetForegroundWindow(), sConnect))) Then Exit Function
    End If
        
    If (ofbk__mainDialog(bInsertEnabled)) Then
        'We want to save this connection to the .INI/Registry,
        'however, it is probably a bad idea to write the WHOLE
        'connect string, as it may contain some sensitive info (like a password)
        ofx_OfbkMainDialog = ofx_ProfileWriteString("Office Book", "Connect", "ODBC;DSN=" & ofx_OfbkGetDSN())
    End If
    
ofx_OfbkDoMainDialog_Exit:
    Exit Function
ofx_OfbkDoMainDialog_Error:
    Call ofx_GenericError("ofx_OfbkMainDialog()", Err)
    Resume ofx_OfbkDoMainDialog_Exit
End Function






'------------------------------------------------------------------------------
' Function: ofx_OfbkEditRecordDlg
'
' Purpose:  Displays the OfficeBook "Edit" dialog.
'
' Params:   hWnd            (I) The parent window handle (should not be null)
'           bInsertEnabled  (I) Enable the "Insert" button
'           sConnect        (I) The connection string (can be blank and this implementation
'                               will try to read the default setting from the .INI/Registry
