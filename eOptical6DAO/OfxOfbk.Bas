'------------------------------------------------------------------------------
' Function: ofbk__isCreated
'
' Purpose:  Determine if reference to OfficeBook is valid.
'
' Returns:  True if OfficeBook reference is valid, else False.
'
' Notes:    Helper function for platform compatability
'------------------------------------------------------------------------------
Private Function ofbk__isCreated() As Boolean
#If Win32 Then
    ofbk__isCreated = (Not (s_ofbk Is Nothing))
#Else
    ofbk__isCreated = (s_nOfbkId > 0)
#End If
End Function
