'------------------------------------------------------------------------------
' Function: ofx_OfbkGetConnect
'
' Purpose:  Get the current database connection string.
'
' Returns:  The current connection string.
'
' See also: ofx_OfbkGetDSN(), ofx_OfbkGetUID()
'------------------------------------------------------------------------------
Public Function ofx_OfbkGetConnect() As String
If (ofx_OfbkIsOpen()) Then

    #If Win32 Then
        ofx_OfbkGetConnect = s_ofbk.Connect
    #Else
        Dim nLen As Integer
        Dim sBuf As String
        sBuf = String$(256, 0)
        nLen = OfbkGetConnect(s_nOfbkId, sBuf, 255)
        ofx_OfbkGetConnect = Left$(sBuf, nLen)
    #End If
End If
End Function





