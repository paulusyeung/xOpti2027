Attribute VB_Name = "frmStaff"
Attribute VB_Creatable = False
Attribute VB_Exposed = False

Private Sub cmdSortByFirstName_Click(Value As Integer)
  VBCP_Update 62, "cmdSortByFirstName_Click", 1
    Dim strSQL As String
    If cmdSortByFirstName.Value And VBCP_UpdateIf(62, "cmdSortByFirstName_Click", 2) Then
        strSQL = "SELECT * FROM Staff ORDER BY StaffFirstName ASC, StaffLastName ASC"
  VBCP_Update 62, "cmdSortByFirstName_Click", 3
    Else
        strSQL = "SELECT * FROM Staff ORDER BY StaffFirstName DESC, StaffLastName ASC"
  VBCP_Update 62, "cmdSortByFirstName_Click", 4
    End If
    dtcStaff.RecordSource = strSQL
  VBCP_Update 62, "cmdSortByFirstName_Click", 5
    dtcStaff.Refresh
  VBCP_Update 62, "cmdSortByFirstName_Click", 6
    dtcStaff.UpdateControls
  VBCP_Update 62, "cmdSortByFirstName_Click", 7
End Sub

Private Sub cmdSortByID_Click(Value As Integer)
  VBCP_Update 62, "cmdSortByID_Click", 1
    Dim strSQL As String
    If cmdSortByID.Value And VBCP_UpdateIf(62, "cmdSortByID_Click", 2) Then
        strSQL = "SELECT * FROM Staff ORDER BY StaffCode ASC"
  VBCP_Update 62, "cmdSortByID_Click", 3
    Else
        strSQL = "SELECT * FROM Staff ORDER BY StaffCode DESC"
  VBCP_Update 62, "cmdSortByID_Click", 4
    End If
    dtcStaff.RecordSource = strSQL
  VBCP_Update 62, "cmdSortByID_Click", 5
    dtcStaff.Refresh
  VBCP_Update 62, "cmdSortByID_Click", 6
    dtcStaff.UpdateControls
  VBCP_Update 62, "cmdSortByID_Click", 7
End Sub

Private Sub cmdSortByLastName_Click(Value As Integer)
  VBCP_Update 62, "cmdSortByLastName_Click", 1
    Dim strSQL As String
    If cmdSortByLastName.Value And VBCP_UpdateIf(62, "cmdSortByLastName_Click", 2) Then
        strSQL = "SELECT * FROM Staff ORDER BY StaffLastName ASC, StaffFirstName ASC"
  VBCP_Update 62, "cmdSortByLastName_Click", 3
    Else
        strSQL = "SELECT * FROM Staff ORDER BY StaffLastName DESC, StaffFirstName ASC"
  VBCP_Update 62, "cmdSortByLastName_Click", 4
    End If
    dtcStaff.RecordSource = strSQL
  VBCP_Update 62, "cmdSortByLastName_Click", 5
    dtcStaff.Refresh
  VBCP_Update 62, "cmdSortByLastName_Click", 6
    dtcStaff.UpdateControls
  VBCP_Update 62, "cmdSortByLastName_Click", 7
End Sub

Private Sub dbcCity_Click(intArea As Integer)
  VBCP_Update 62, "dbcCity_Click", 1

    Dim strTarget As String
    
    If intArea = dbcAreaList And VBCP_UpdateIf(62, "dbcCity_Click", 2) Then
        ' Sync dtcCity
        strTarget = "Code = " & dbcCity.BoundText
  VBCP_Update 62, "dbcCity_Click", 3
        dtcCity.Recordset.FindFirst strTarget
  VBCP_Update 62, "dbcCity_Click", 4
        If Not dtcCity.Recordset.NoMatch And VBCP_UpdateIf(62, "dbcCity_Click", 5) Then
            dtcCity.UpdateControls
  VBCP_Update 62, "dbcCity_Click", 6
            ' Fill Supplier fields: Province and Country
            If Not (dtcStaff.Recordset.EditMode = dbEditAdd) And VBCP_UpdateIf(62, "dbcCity_Click", 7) Then dtcStaff.Recordset.Edit
            dtcStaff.Recordset!HomeProvince = dtcCity.Recordset!ProvinceCode
  VBCP_Update 62, "dbcCity_Click", 8
            dtcStaff.Recordset!HomeCountry = dtcCity.Recordset!CountryCode
  VBCP_Update 62, "dbcCity_Click", 9
        End If
    End If

End Sub

Private Sub dbcCity_GotFocus()
  VBCP_Update 62, "dbcCity_GotFocus", 1
    ' Show Province and Country
    txtSyncProvince.Visible = True
  VBCP_Update 62, "dbcCity_GotFocus", 2
    txtSyncCountry.Visible = True
  VBCP_Update 62, "dbcCity_GotFocus", 3
    txtSyncProvince.ZOrder
  VBCP_Update 62, "dbcCity_GotFocus", 4
    txtSyncCountry.ZOrder
  VBCP_Update 62, "dbcCity_GotFocus", 5

End Sub


Private Sub dbcCity_LostFocus()
  VBCP_Update 62, "dbcCity_LostFocus", 1
    ' Hide Province and Country
    txtSyncProvince.Visible = False
  VBCP_Update 62, "dbcCity_LostFocus", 2
    txtSyncCountry.Visible = False
  VBCP_Update 62, "dbcCity_LostFocus", 3

End Sub

Private Sub dbcStaffFullName_Click(intArea As Integer)
  VBCP_Update 62, "dbcStaffFullName_Click", 1
    ' Display the content of the selected staff
    If intArea = dbcAreaList And VBCP_UpdateIf(62, "dbcStaffFullName_Click", 2) Then
        Dim MyCriteria As String
        MyCriteria = "StaffFullName = '" & dbcStaffFullName.Text & "'"  ' Set the criteria
  VBCP_Update 62, "dbcStaffFullName_Click", 3
        dtcStaff.Recordset.FindFirst MyCriteria   ' Find first matching record.
  VBCP_Update 62, "dbcStaffFullName_Click", 4
        If Not dtcStaff.Recordset.NoMatch And VBCP_UpdateIf(62, "dbcStaffFullName_Click", 5) Then    ' Check if record is found.
            dtcStaff.UpdateControls
  VBCP_Update 62, "dbcStaffFullName_Click", 6
        End If
    End If
End Sub

Private Sub dbcStaffFullName_GotFocus()
  VBCP_Update 62, "dbcStaffFullName_GotFocus", 1
    ' If AddNew, compose Full Name by First Name + Initial + Last Name
    If (dbcStaffFullName = "") And _
        IsNull(dtcStaff.Recordset("StaffFullName")) And VBCP_UpdateIf(62, "dbcStaffFullName_GotFocus", 2) Then
        If (dbcStaffInitial = "") Then
            dbcStaffFullName.Text = txtFirstName.Text & " " & txtLastName
  VBCP_Update 62, "dbcStaffFullName_GotFocus", 3
        Else
            dbcStaffFullName.Text = txtFirstName.Text & " " & mskStaffInitial & " " & txtLastName
  VBCP_Update 62, "dbcStaffFullName_GotFocus", 4
        End If
    End If
End Sub


Private Sub dtcStaff_Reposition()
  VBCP_Update 62, "dtcStaff_Reposition", 1

    Dim strTarget As String
    
    ' Synconize the related tables
    If Not (dtcStaff.Recordset.EOF Or dtcStaff.Recordset.BOF) And VBCP_UpdateIf(62, "dtcStaff_Reposition", 2) Then
        If dtcStaff.Recordset!HomeCity <> "" And VBCP_UpdateIf(62, "dtcStaff_Reposition", 3) Then
            ' Sync dtcCity
            strTarget = "Code = " & dtcStaff.Recordset!HomeCity
  VBCP_Update 62, "dtcStaff_Reposition", 4
            dtcCity.Recordset.FindFirst strTarget
  VBCP_Update 62, "dtcStaff_Reposition", 5
            If Not dtcCity.Recordset.NoMatch Then _
