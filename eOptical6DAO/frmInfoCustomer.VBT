Private Sub cmdFindBizPhone_Click()
  VBCP_Update 94, "cmdFindBizPhone_Click", 1

    On Error GoTo cmdFindBizPhone_Click_Err


    If txtSelBizPhone <> "" And VBCP_UpdateIf(94, "cmdFindBizPhone_Click", 2) Then
        ' Lookup dtcCustomer
        strSQL = "SELECT * FROM Customer " _
               & "WHERE BizPhone LIKE '" & txtSelBizPhone.Text & "' " _
