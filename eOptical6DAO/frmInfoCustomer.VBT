Private Sub dbgOrders_DblClick()
  VBCP_Update 94, "dbgOrders_DblClick", 1
    Dim strTxNumber As String
    
    strTxNumber = ofx_CStr(dbgOrders.Columns("Order Number").Value)
  VBCP_Update 94, "dbgOrders_DblClick", 2
    If strTxNumber <> "" And VBCP_UpdateIf(94, "dbgOrders_DblClick", 3) Then
        RptTxNumberFrom = strTxNumber
  VBCP_Update 94, "dbgOrders_DblClick", 4
        Screen.MousePointer = vbHourGlasses
  VBCP_Update 94, "dbgOrders_DblClick", 5
        Call PrintOrder(1, 0)
  VBCP_Update 94, "dbgOrders_DblClick", 6
    End If
End Sub


Private Sub dbgOrders_GotFocus()
  VBCP_Update 94, "dbgOrders_GotFocus", 1
    Screen.MousePointer = vbArrowQuestion
  VBCP_Update 94, "dbgOrders_GotFocus", 2
End Sub


Private Sub dbgOrders_LostFocus()
  VBCP_Update 94, "dbgOrders_LostFocus", 1
    Screen.MousePointer = vbDefault
  VBCP_Update 94, "dbgOrders_LostFocus", 2
End Sub

Private Sub dtcCustomer_Reposition()
  VBCP_Update 94, "dtcCustomer_Reposition", 1

    On Error GoTo dtcCustomer_Reposition_Err


    Dim strTarget As String
    If Not (dtcCustomer.Recordset.EOF Or dtcCustomer.Recordset.BOF) And VBCP_UpdateIf(94, "dtcCustomer_Reposition", 2) Then
        ' Sync Home Address
        If dtcCustomer.Recordset!HomeCity <> "" And VBCP_UpdateIf(94, "dtcCustomer_Reposition", 3) Then
            strTarget = "SELECT * FROM qryCityFullList WHERE Code = " & dtcCustomer.Recordset!HomeCity
  VBCP_Update 94, "dtcCustomer_Reposition", 4
        Else
            strTarget = "SELECT * FROM qryCityFullList WHERE Code = 0"
  VBCP_Update 94, "dtcCustomer_Reposition", 5
        End If
        dtcHomeCity.RecordSource = strTarget
  VBCP_Update 94, "dtcCustomer_Reposition", 6
        dtcHomeCity.Refresh
  VBCP_Update 94, "dtcCustomer_Reposition", 7
        dtcHomeCity.UpdateControls
  VBCP_Update 94, "dtcCustomer_Reposition", 8
        ' Sync Biz Address
        If dtcCustomer.Recordset!BizCity <> "" And VBCP_UpdateIf(94, "dtcCustomer_Reposition", 9) Then
            strTarget = "SELECT * FROM qryCityFullList WHERE Code = " & dtcCustomer.Recordset!BizCity
  VBCP_Update 94, "dtcCustomer_Reposition", 10
        Else
            strTarget = "SELECT * FROM qryCityFullList WHERE Code = 0"
  VBCP_Update 94, "dtcCustomer_Reposition", 11
        End If
        dtcBizCity.RecordSource = strTarget
  VBCP_Update 94, "dtcCustomer_Reposition", 12
        dtcBizCity.Refresh
  VBCP_Update 94, "dtcCustomer_Reposition", 13
        dtcBizCity.UpdateControls
  VBCP_Update 94, "dtcCustomer_Reposition", 14
        ' Sync Customer Medical Table
        strTarget = "SELECT * FROM CustomerMedical WHERE CustomerID = " & dtcCustomer.Recordset!ID
  VBCP_Update 94, "dtcCustomer_Reposition", 15
        dtcCusMedical.RecordSource = strTarget
  VBCP_Update 94, "dtcCustomer_Reposition", 16
        dtcCusMedical.Refresh
  VBCP_Update 94, "dtcCustomer_Reposition", 17
        dtcCusMedical.UpdateControls
  VBCP_Update 94, "dtcCustomer_Reposition", 18
        ' Sync Customer Prescription (Lens) Table
        strTarget = "SELECT * FROM CustomerPresLens WHERE CustomerID = " & dtcCustomer.Recordset!ID
  VBCP_Update 94, "dtcCustomer_Reposition", 19
        dtcCusPresLens.RecordSource = strTarget
  VBCP_Update 94, "dtcCustomer_Reposition", 20
        dtcCusPresLens.Refresh
  VBCP_Update 94, "dtcCustomer_Reposition", 21
        dtcCusPresLens.UpdateControls
  VBCP_Update 94, "dtcCustomer_Reposition", 22
        ' Sync Customer Prescription (Contact Lens)Table
        strTarget = "SELECT * FROM CustomerPresContact WHERE CustomerID = " & dtcCustomer.Recordset!ID
  VBCP_Update 94, "dtcCustomer_Reposition", 23
        dtcCusPresCont.RecordSource = strTarget
  VBCP_Update 94, "dtcCustomer_Reposition", 24
        dtcCusPresCont.Refresh
  VBCP_Update 94, "dtcCustomer_Reposition", 25
        dtcCusPresCont.UpdateControls
  VBCP_Update 94, "dtcCustomer_Reposition", 26
        
        ' Sync qrySOrderSimple Table
        strTarget = "SELECT * FROM qrySOrderSimple WHERE CustomerID = " & dtcCustomer.Recordset!ID
  VBCP_Update 94, "dtcCustomer_Reposition", 27
        dtcQrySOrderSimple.RecordSource = strTarget
  VBCP_Update 94, "dtcCustomer_Reposition", 28
        dtcQrySOrderSimple.Refresh
  VBCP_Update 94, "dtcCustomer_Reposition", 29
        dtcQrySOrderSimple.UpdateControls
  VBCP_Update 94, "dtcCustomer_Reposition", 30
        
        ' The following lines are added because the Sheriden's Calendar DateCombo
        ' could not handle DataBound with Null value properly.
        If Not IsNull(dtcCustomer.Recordset!Birthday) Then _
