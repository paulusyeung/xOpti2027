Attribute VB_Name = "frmCity"
Attribute VB_Creatable = False
Attribute VB_Exposed = False

Private Sub cmdLockCountry_Click(Value As Integer)
  VBCP_Update 63, "cmdLockCountry_Click", 1
    Select Case Value
    Case True   ' Lock the Country Info
  VBCP_Update 63, "cmdLockCountry_Click", 2
        ' Set button background color to white
        cmdLockCountry.BackColor = &HFFFFFF
  VBCP_Update 63, "cmdLockCountry_Click", 3
        ' Lock the last Country Code & Country Name
        txtLastCountryName.Text = dbcCountry.Text
  VBCP_Update 63, "cmdLockCountry_Click", 4
        txtLastCountryCode.Text = dbcCountry.BoundText
  VBCP_Update 63, "cmdLockCountry_Click", 5
        ' Disable the dbcCountry
        dbcCountry.Enabled = False
  VBCP_Update 63, "cmdLockCountry_Click", 6
    Case False  ' Unlock the Country Info
  VBCP_Update 63, "cmdLockCountry_Click", 7
        ' Set button background color to gray
        cmdLockCountry.BackColor = &HC0C0C0      ' Gray
  VBCP_Update 63, "cmdLockCountry_Click", 8
        ' Enable the dbcCountry
        dbcCountry.Enabled = True
  VBCP_Update 63, "cmdLockCountry_Click", 9
    End Select

End Sub

Private Sub cmdLockProvince_Click(Value As Integer)
  VBCP_Update 63, "cmdLockProvince_Click", 1
    Select Case Value
    Case True   ' Lock the Province Info
  VBCP_Update 63, "cmdLockProvince_Click", 2
        ' Set button background color to white
        cmdLockProvince.BackColor = &HFFFFFF
  VBCP_Update 63, "cmdLockProvince_Click", 3
        ' Lock the last Province Code & Province Name
        txtLastProvinceName.Text = dbcProvince.Text
  VBCP_Update 63, "cmdLockProvince_Click", 4
        txtLastProvinceCode.Text = dbcProvince.BoundText
  VBCP_Update 63, "cmdLockProvince_Click", 5
        ' Disable the dbcProvince
        dbcProvince.Enabled = False
  VBCP_Update 63, "cmdLockProvince_Click", 6
    Case False  ' Unlock the Province Info
  VBCP_Update 63, "cmdLockProvince_Click", 7
        ' Set button background color to gray
        cmdLockProvince.BackColor = &HC0C0C0      ' Gray
  VBCP_Update 63, "cmdLockProvince_Click", 8
        ' Enable the dbcProvince
        dbcProvince.Enabled = True
  VBCP_Update 63, "cmdLockProvince_Click", 9
    End Select

End Sub

Private Sub dbcSelCountry_Click(intArea As Integer)
  VBCP_Update 63, "dbcSelCountry_Click", 1
    If intArea = dbcAreaList And VBCP_UpdateIf(63, "dbcSelCountry_Click", 2) Then
        ' Lookup dtcCity
        If cmdCascadeCountry.Value And VBCP_UpdateIf(63, "dbcSelCountry_Click", 3) Then    ' Cascade selected
            LookupByCascade
  VBCP_Update 63, "dbcSelCountry_Click", 4
        Else                            ' No cascade
            strSQL = "SELECT * FROM City " _
                & "WHERE CountryCode = '" & dbcSelCountry.BoundText & "' " _
                & "ORDER BY CityName"
  VBCP_Update 63, "dbcSelCountry_Click", 5
            dtcCity.RecordSource = strSQL
            dtcCity.Refresh
  VBCP_Update 63, "dbcSelCountry_Click", 6
            dtcCity.UpdateControls
  VBCP_Update 63, "dbcSelCountry_Click", 7
        End If
    End If

End Sub

Private Sub dbcSelProvince_Click(intArea As Integer)
  VBCP_Update 63, "dbcSelProvince_Click", 1
    If intArea = dbcAreaList And VBCP_UpdateIf(63, "dbcSelProvince_Click", 2) Then
        ' Lookup dtcCity
        If cmdCascadeProvince.Value And VBCP_UpdateIf(63, "dbcSelProvince_Click", 3) Then    ' Cascade selected
            LookupByCascade
  VBCP_Update 63, "dbcSelProvince_Click", 4
        Else                            ' No cascade
            strSQL = "SELECT * FROM City " _
                & "WHERE ProvinceCode = '" & dbcSelProvince.BoundText & "' " _
                & "ORDER BY CityName"
  VBCP_Update 63, "dbcSelProvince_Click", 5
            dtcCity.RecordSource = strSQL
            dtcCity.Refresh
  VBCP_Update 63, "dbcSelProvince_Click", 6
            dtcCity.UpdateControls
  VBCP_Update 63, "dbcSelProvince_Click", 7
        End If
    End If

End Sub

Private Sub Form_Activate()
  VBCP_Update 63, "Form_Activate", 1
    Screen.MousePointer = vbDefault
  VBCP_Update 63, "Form_Activate", 2

End Sub

Private Sub Form_Load()
  VBCP_Update 63, "Form_Load", 1
    Call ofx_CenterForm(Me)
  VBCP_Update 63, "Form_Load", 2
End Sub


Private Sub SSCommand1_Click()
  VBCP_Update 63, "SSCommand1_Click", 1
    If ofx_IsFormLoaded(frmCountry) Then _
