Private Sub dbcBizCity_Click(intArea As Integer)
  VBCP_Update 55, "dbcBizCity_Click", 1

    Dim strTarget As String
    
    If intArea = dbcAreaList And VBCP_UpdateIf(55, "dbcBizCity_Click", 2) Then
        ' Sync dtcBizCity
        strTarget = "Code = " & dbcBizCity.BoundText
  VBCP_Update 55, "dbcBizCity_Click", 3
        dtcBizCity.Recordset.FindFirst strTarget
  VBCP_Update 55, "dbcBizCity_Click", 4
        If Not dtcBizCity.Recordset.NoMatch And VBCP_UpdateIf(55, "dbcBizCity_Click", 5) Then
            dtcBizCity.UpdateControls
  VBCP_Update 55, "dbcBizCity_Click", 6
            ' Fill Supplier fields: Biz Province and Country
            If Not blnAddNew And VBCP_UpdateIf(55, "dbcBizCity_Click", 7) Then dtcCustomer.Recordset.Edit
            dtcCustomer.Recordset.Fields("BizProvince") = dtcBizCity.Recordset.Fields("ProvinceCode")
  VBCP_Update 55, "dbcBizCity_Click", 8
            dtcCustomer.Recordset.Fields("BizCountry") = dtcBizCity.Recordset.Fields("CountryCode")
  VBCP_Update 55, "dbcBizCity_Click", 9
            ' Sync dtcBizProvince
            strTarget = "ProvinceCode = '" & dtcBizCity.Recordset.Fields("ProvinceCode") & "'"
  VBCP_Update 55, "dbcBizCity_Click", 10
            dtcBizProvince.Recordset.FindFirst strTarget
  VBCP_Update 55, "dbcBizCity_Click", 11
            If Not dtcBizProvince.Recordset.NoMatch And VBCP_UpdateIf(55, "dbcBizCity_Click", 12) Then
                dtcBizProvince.UpdateControls
  VBCP_Update 55, "dbcBizCity_Click", 13
                dbcBizProvince.Text = dtcBizProvince.Recordset.Fields("ProvinceName")
  VBCP_Update 55, "dbcBizCity_Click", 14
            End If
            ' Sync dtcBizCountry
            strTarget = "CountryCode = '" & dtcBizCity.Recordset.Fields("CountryCode") & "'"
  VBCP_Update 55, "dbcBizCity_Click", 15
            dtcBizCountry.Recordset.FindFirst strTarget
  VBCP_Update 55, "dbcBizCity_Click", 16
            If Not dtcBizCountry.Recordset.NoMatch And VBCP_UpdateIf(55, "dbcBizCity_Click", 17) Then
                dtcBizCountry.UpdateControls
  VBCP_Update 55, "dbcBizCity_Click", 18
                dbcBizCountry.Text = dtcBizCountry.Recordset.Fields("CountryName")
  VBCP_Update 55, "dbcBizCity_Click", 19
            End If
        End If
    End If

End Sub

Private Sub dbcBizCity_GotFocus()
  VBCP_Update 55, "dbcBizCity_GotFocus", 1
    ' Show Province and Country
    txtSyncBizProvince.Visible = True
  VBCP_Update 55, "dbcBizCity_GotFocus", 2
    txtSyncBizCountry.Visible = True
  VBCP_Update 55, "dbcBizCity_GotFocus", 3
    txtSyncBizProvince.ZOrder
  VBCP_Update 55, "dbcBizCity_GotFocus", 4
    txtSyncBizCountry.ZOrder
  VBCP_Update 55, "dbcBizCity_GotFocus", 5

End Sub


Private Sub dbcBizCity_LostFocus()
  VBCP_Update 55, "dbcBizCity_LostFocus", 1
    ' Hide Province and Country
    txtSyncBizProvince.Visible = False
  VBCP_Update 55, "dbcBizCity_LostFocus", 2
    txtSyncBizCountry.Visible = False
  VBCP_Update 55, "dbcBizCity_LostFocus", 3

End Sub

Private Sub dbcCity_Click(intArea As Integer)
  VBCP_Update 55, "dbcCity_Click", 1

    Dim strTarget As String
    
    If intArea = dbcAreaList And VBCP_UpdateIf(55, "dbcCity_Click", 2) Then
        ' Sync dtcCity
        strTarget = "Code = " & dbcCity.BoundText
  VBCP_Update 55, "dbcCity_Click", 3
        dtcCity.Recordset.FindFirst strTarget
  VBCP_Update 55, "dbcCity_Click", 4
        If Not dtcCity.Recordset.NoMatch And VBCP_UpdateIf(55, "dbcCity_Click", 5) Then
            dtcCity.UpdateControls
  VBCP_Update 55, "dbcCity_Click", 6
            ' Fill Supplier fields: Province and Country
            If Not blnAddNew And VBCP_UpdateIf(55, "dbcCity_Click", 7) Then dtcCustomer.Recordset.Edit
            dtcCustomer.Recordset.Fields("HomeProvince") = dtcCity.Recordset.Fields("ProvinceCode")
  VBCP_Update 55, "dbcCity_Click", 8
            dtcCustomer.Recordset.Fields("HomeCountry") = dtcCity.Recordset.Fields("CountryCode")
  VBCP_Update 55, "dbcCity_Click", 9
            ' Sync dtcProvince
            strTarget = "ProvinceCode = '" & dtcCity.Recordset.Fields("ProvinceCode") & "'"
  VBCP_Update 55, "dbcCity_Click", 10
            dtcProvince.Recordset.FindFirst strTarget
  VBCP_Update 55, "dbcCity_Click", 11
            If Not dtcProvince.Recordset.NoMatch And VBCP_UpdateIf(55, "dbcCity_Click", 12) Then
                dtcProvince.UpdateControls
  VBCP_Update 55, "dbcCity_Click", 13
                dbcProvince.Text = dtcProvince.Recordset.Fields("ProvinceName")
  VBCP_Update 55, "dbcCity_Click", 14
            End If
            ' Sync dtcCountry
            strTarget = "CountryCode = '" & dtcCity.Recordset.Fields("CountryCode") & "'"
  VBCP_Update 55, "dbcCity_Click", 15
            dtcCountry.Recordset.FindFirst strTarget
  VBCP_Update 55, "dbcCity_Click", 16
            If Not dtcCountry.Recordset.NoMatch And VBCP_UpdateIf(55, "dbcCity_Click", 17) Then
                dtcCountry.UpdateControls
  VBCP_Update 55, "dbcCity_Click", 18
                dbcCountry.Text = dtcCountry.Recordset.Fields("CountryName")
  VBCP_Update 55, "dbcCity_Click", 19
            End If
        End If
    End If

End Sub

Private Sub dbcCity_GotFocus()
  VBCP_Update 55, "dbcCity_GotFocus", 1
    ' Show Province and Country
    txtSyncProvince.Visible = True
  VBCP_Update 55, "dbcCity_GotFocus", 2
    txtSyncCountry.Visible = True
  VBCP_Update 55, "dbcCity_GotFocus", 3
    txtSyncProvince.ZOrder
  VBCP_Update 55, "dbcCity_GotFocus", 4
    txtSyncCountry.ZOrder
  VBCP_Update 55, "dbcCity_GotFocus", 5
End Sub


Private Sub dbcCity_LostFocus()
  VBCP_Update 55, "dbcCity_LostFocus", 1
    ' Hide Province and Country
    txtSyncProvince.Visible = False
  VBCP_Update 55, "dbcCity_LostFocus", 2
    txtSyncCountry.Visible = False
  VBCP_Update 55, "dbcCity_LostFocus", 3

End Sub

Private Sub dbcCustomerFullName_Click(intArea As Integer)
  VBCP_Update 55, "dbcCustomerFullName_Click", 1
    ' Display the content of the selected staff
    If intArea = dbcAreaList And VBCP_UpdateIf(55, "dbcCustomerFullName_Click", 2) Then
        Dim MyCriteria As String
        MyCriteria = "FullName = '" & dbcCustomerFullName.Text & "'"  ' Set the criteria
  VBCP_Update 55, "dbcCustomerFullName_Click", 3
        dtcCustomer.Recordset.FindFirst MyCriteria   ' Find first matching record.
  VBCP_Update 55, "dbcCustomerFullName_Click", 4
        If Not dtcCustomer.Recordset.NoMatch And VBCP_UpdateIf(55, "dbcCustomerFullName_Click", 5) Then    ' Check if record is found.
            dtcCustomer.UpdateControls
  VBCP_Update 55, "dbcCustomerFullName_Click", 6
        End If
    End If

End Sub

Private Sub dbcCustomerFullName_GotFocus()
  VBCP_Update 55, "dbcCustomerFullName_GotFocus", 1
    ' If AddNew, compose Full Name by First Name + Initial + Last Name
    If (dbcCustomerFullName = "") And _
        IsNull(dtcCustomer.Recordset("FullName")) And VBCP_UpdateIf(55, "dbcCustomerFullName_GotFocus", 2) Then
        If (mskCustomerInitial = "") Then
            dbcCustomerFullName.Text = txtFirstName.Text & " " & txtLastName
  VBCP_Update 55, "dbcCustomerFullName_GotFocus", 3
        Else
            dbcCustomerFullName.Text = txtFirstName.Text & " " & mskCustomerInitial & " " & txtLastName
  VBCP_Update 55, "dbcCustomerFullName_GotFocus", 4
        End If
    End If

End Sub


Private Sub dtcCustomer_Reposition()
  VBCP_Update 55, "dtcCustomer_Reposition", 1

    Dim strTarget As String
    
    ' Avoid Rreposition if
    ' 1. Customer Table is empty
    ' 2. Adding new record
    ' 3. Overflow BeginOfFile or EndOfFile
    If IsEmpty(dtcCustomer.Recordset) And VBCP_UpdateIf(55, "dtcCustomer_Reposition", 2) Then Exit Sub
    If dtcCustomer.Recordset.EditMode = dbEditAdd And VBCP_UpdateIf(55, "dtcCustomer_Reposition", 3) Then Exit Sub
    If (dtcCustomer.Recordset.BOF Or dtcCustomer.Recordset.EOF) And VBCP_UpdateIf(55, "dtcCustomer_Reposition", 4) Then Exit Sub
        
        If dtcCustomer.Recordset!HomeCity <> "" And VBCP_UpdateIf(55, "dtcCustomer_Reposition", 5) Then
            ' Sync dtcCity
            strTarget = "Code = " & dtcCustomer.Recordset.Fields("HomeCity")
  VBCP_Update 55, "dtcCustomer_Reposition", 6
            dtcCity.Recordset.FindFirst strTarget
  VBCP_Update 55, "dtcCustomer_Reposition", 7
            If Not dtcCity.Recordset.NoMatch Then _
