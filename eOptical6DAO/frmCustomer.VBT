Private Sub cmdSortByFirstName_Click(Value As Integer)
  VBCP_Update 55, "cmdSortByFirstName_Click", 1
    Dim strSQL As String
    If cmdSortByFirstName.Value And VBCP_UpdateIf(55, "cmdSortByFirstName_Click", 2) Then
        strSQL = "SELECT * FROM Customer ORDER BY FirstName ASC, LastName ASC"
  VBCP_Update 55, "cmdSortByFirstName_Click", 3
    Else
        strSQL = "SELECT * FROM Customer ORDER BY FirstName DESC, LastName ASC"
  VBCP_Update 55, "cmdSortByFirstName_Click", 4
    End If
    dtcCustomer.RecordSource = strSQL
  VBCP_Update 55, "cmdSortByFirstName_Click", 5
    dtcCustomer.Refresh
  VBCP_Update 55, "cmdSortByFirstName_Click", 6
    dtcCustomer.UpdateControls
  VBCP_Update 55, "cmdSortByFirstName_Click", 7
End Sub


