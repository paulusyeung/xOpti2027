Attribute VB_Name = "frmCustAskDays"
Attribute VB_Creatable = False
Attribute VB_Exposed = False



Private Sub cmdPrnSetup_Click()

    On Error GoTo cmdPrnSetup_Click_Err

    frmCtlCrw.CommonDialog1.Flags = &H40  'force the printers setup dialog box
    frmCtlCrw.CommonDialog1.Action = 5    'run the printer setup

cmdPrnSetup_Click_Exit:   ' SDVB autocode
    On Error Resume Next  ' SDVB autocode
    Exit Sub              ' SDVB autocode
cmdPrnSetup_Click_Err:    ' SDVB autocode
    MsgBox Error          ' SDVB autocode
    Resume cmdPrnSetup_Click_Exit

End Sub



Private Sub cmdCancel_Click()

    On Error GoTo cmdCancel_Click_Err
    Unload Me
cmdCancel_Click_Exit:     ' SDVB autocode
    On Error Resume Next  ' SDVB autocode
    Exit Sub              ' SDVB autocode
cmdCancel_Click_Err:      ' SDVB autocode
    MsgBox Error          ' SDVB autocode
    Resume cmdCancel_Click_Exit
End Sub

Private Sub cmdOK_Click()

    On Error GoTo cmdOK_Click_Err
   
    Screen.MousePointer = 13
    ' check range of me.txtdays
    If InRange(Me.txtDays, "Days", 180, 1, True) Then
        '   Birthday Reminder
        If CrwRptName = "Birthday Reminder" Then
            frmCtlCrw.CrystalReport1.Formulas(0) = "AskDays =" & Me.txtDays
            'MsgBox frmCtlCrw.crystalReport1.Formulas(0)
            frmCtlCrw.CrystalReport1.Formulas(1) = "AskZeroPurchase = " & Me.optYes
            'MsgBox frmCtlCrw.crystalReport1.Formulas(1)
            frmCtlCrw.CrystalReport1.SelectionFormula = "Month ({Customer.Birthday})" & _
            " In Month(currentdate-" & Me.txtDays & ")" & _
            " To Month(currentdate+" & Me.txtDays & ")"
            'Debug.Print me.optYes, me.optNo
            If Me.optNo Then
                frmCtlCrw.CrystalReport1.SelectionFormula = frmCtlCrw.CrystalReport1.SelectionFormula & _
                " AND ({CustomerAccounts.YTDAmtPurchased}-{CustomerAccounts.YTDAmtRefund}) > 0"
            End If
        '
        ElseIf CrwRptName = "Customer Listing (Active)" Then
            frmCtlCrw.CrystalReport1.Formulas(0) = "AskDays =" & Me.txtDays
            frmCtlCrw.CrystalReport1.Formulas(1) = "AskZeroPurchase = " & Me.optYes
            frmCtlCrw.CrystalReport1.SelectionFormula = "({CustomerAccounts.LastPurchaseDate}+ " _
                & Me.txtDays & ") >= currentdate"
            If Me.optNo Then
                frmCtlCrw.CrystalReport1.SelectionFormula = frmCtlCrw.CrystalReport1.SelectionFormula & _
                " AND ({CustomerAccounts.YTDAmtPurchased}-{CustomerAccounts.YTDAmtRefund}) > 0"
            End If
        '
        ElseIf CrwRptName = "Customer Listing (Inactive)" Then
            frmCtlCrw.CrystalReport1.Formulas(0) = "AskDays =" & Me.txtDays
            frmCtlCrw.CrystalReport1.Formulas(1) = "AskZeroPurchase = " & Me.optYes
            frmCtlCrw.CrystalReport1.SelectionFormula = "({CustomerAccounts.LastPurchaseDate}+ " _
                & Me.txtDays & ") <= currentdate"
            If Me.optYes Then
                frmCtlCrw.CrystalReport1.SelectionFormula = frmCtlCrw.CrystalReport1.SelectionFormula & _
                " OR ({CustomerAccounts.YTDAmtPurchased}-{CustomerAccounts.YTDAmtRefund}) <= 0"
            End If
        ElseIf CrwRptName = "VIP Listing (Inactive)" Then
            frmCtlCrw.CrystalReport1.Formulas(0) = "AskDays =" & Me.txtDays
            frmCtlCrw.CrystalReport1.Formulas(1) = "AskZeroPurchase = " & Me.optYes
            frmCtlCrw.CrystalReport1.SelectionFormula = "not isnull({Customer.VIPCode})" & _
               " AND ({CustomerAccounts.LastPurchaseDate}+ " _
                & Me.txtDays & ") <= currentdate"
            If Me.optYes Then
                frmCtlCrw.CrystalReport1.SelectionFormula = frmCtlCrw.CrystalReport1.SelectionFormula & _
                " OR ({CustomerAccounts.YTDAmtPurchased}-{CustomerAccounts.YTDAmtRefund}) <= 0"
            End If
        ElseIf CrwRptName = "Insurance Reminder" Then
            frmCtlCrw.CrystalReport1.Formulas(0) = "AskDays =" & Me.txtDays
            frmCtlCrw.CrystalReport1.Formulas(1) = "AskZeroPurchase = " & Me.optYes
        End If
        'MsgBox frmCtlCrw.crystalReport1.SelectionFormula
        Screen.MousePointer = 11
        frmCtlCrw.CrystalReport1.Action = 1
        Screen.MousePointer = 0
    Else
        Call cmdReset_Click
    End If

cmdOK_Click_Exit:         ' SDVB autocode
    On Error Resume Next  ' SDVB autocode
    Exit Sub              ' SDVB autocode
cmdOK_Click_Err:          ' SDVB autocode
    Screen.MousePointer = 0
    MsgBox Error          ' SDVB autocode
    Resume cmdOK_Click_Exit

End Sub


Private Sub cmdReset_Click()

    On Error GoTo cmdReset_Click_Err

    Me.optYes = True
    Me.optNo = False
    Me.txtDays = 30
    Me.optYes.SetFocus

cmdReset_Click_Exit:      ' SDVB autocode
    On Error Resume Next  ' SDVB autocode
    Exit Sub              ' SDVB autocode
cmdReset_Click_Err:       ' SDVB autocode
    MsgBox Error          ' SDVB autocode
    Resume cmdReset_Click_Exit

End Sub

Private Sub Form_Load()

    On Error GoTo Form_Load_Err
  
    Screen.MousePointer = 0
    Left = (Screen.Width - Width) / 2   ' Center form horizontally.
    Top = (Screen.Height - Height) / 2  ' Center form vertically.
    
    Me.Caption = CrwRptName

Form_Load_Exit:           ' SDVB autocode
    On Error Resume Next  ' SDVB autocode
    Exit Sub              ' SDVB autocode
Form_Load_Err:            ' SDVB autocode
    MsgBox Error          ' SDVB autocode
    Resume Form_Load_Exit

End Sub








