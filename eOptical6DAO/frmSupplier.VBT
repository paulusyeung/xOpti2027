Attribute VB_Name = "frmSupplier"
Attribute VB_Creatable = False
Attribute VB_Exposed = False
Option Explicit

Dim blnAddNew As Boolean





Private Sub cmdSortBySupplierCode_Click(Value As Integer)
  VBCP_Update 56, "cmdSortBySupplierCode_Click", 1
    Dim strSQL As String
    If cmdSortBySupplierCode.Value And VBCP_UpdateIf(56, "cmdSortBySupplierCode_Click", 2) Then
        strSQL = "SELECT * FROM Supplier ORDER BY SupplierCode ASC"
  VBCP_Update 56, "cmdSortBySupplierCode_Click", 3
    Else
        strSQL = "SELECT * FROM Supplier ORDER BY SupplierCode DESC"
  VBCP_Update 56, "cmdSortBySupplierCode_Click", 4
    End If
    datSupplier.RecordSource = strSQL
  VBCP_Update 56, "cmdSortBySupplierCode_Click", 5
    datSupplier.Refresh
  VBCP_Update 56, "cmdSortBySupplierCode_Click", 6
    datSupplier.UpdateControls
  VBCP_Update 56, "cmdSortBySupplierCode_Click", 7
End Sub

Private Sub cmdSortBySupplierName_Click(Value As Integer)
  VBCP_Update 56, "cmdSortBySupplierName_Click", 1
    Dim strSQL As String
    If cmdSortBySupplierName.Value And VBCP_UpdateIf(56, "cmdSortBySupplierName_Click", 2) Then
        strSQL = "SELECT * FROM Supplier ORDER BY SupplierName ASC"
  VBCP_Update 56, "cmdSortBySupplierName_Click", 3
    Else
        strSQL = "SELECT * FROM Supplier ORDER BY SupplierName DESC"
  VBCP_Update 56, "cmdSortBySupplierName_Click", 4
    End If
    datSupplier.RecordSource = strSQL
  VBCP_Update 56, "cmdSortBySupplierName_Click", 5
    datSupplier.Refresh
  VBCP_Update 56, "cmdSortBySupplierName_Click", 6
    datSupplier.UpdateControls
  VBCP_Update 56, "cmdSortBySupplierName_Click", 7
End Sub

Private Sub cboPriCity_Click(intArea As Integer)
  VBCP_Update 56, "cboPriCity_Click", 1

    Dim strTarget As String
    
    If intArea = dbcAreaList And VBCP_UpdateIf(56, "cboPriCity_Click", 2) Then
        ' Sync dtcCity
        strTarget = "Code = " & cboPriCity.BoundText
  VBCP_Update 56, "cboPriCity_Click", 3
        dtcCity.Recordset.FindFirst strTarget
  VBCP_Update 56, "cboPriCity_Click", 4
        If Not dtcCity.Recordset.NoMatch And VBCP_UpdateIf(56, "cboPriCity_Click", 5) Then
            dtcCity.UpdateControls
  VBCP_Update 56, "cboPriCity_Click", 6
            ' Fill Supplier fields: Province and Country
            If Not blnAddNew And VBCP_UpdateIf(56, "cboPriCity_Click", 7) Then datSupplier.Recordset.Edit
            datSupplier.Recordset.Fields("Province") = dtcCity.Recordset.Fields("ProvinceCode")
  VBCP_Update 56, "cboPriCity_Click", 8
            datSupplier.Recordset.Fields("Country") = dtcCity.Recordset.Fields("CountryCode")
  VBCP_Update 56, "cboPriCity_Click", 9
            ' Sync dtcProvince
            strTarget = "ProvinceCode = '" & dtcCity.Recordset.Fields("ProvinceCode") & "'"
  VBCP_Update 56, "cboPriCity_Click", 10
            dtcProvince.Recordset.FindFirst strTarget
  VBCP_Update 56, "cboPriCity_Click", 11
            If Not dtcProvince.Recordset.NoMatch And VBCP_UpdateIf(56, "cboPriCity_Click", 12) Then
                dtcProvince.UpdateControls
  VBCP_Update 56, "cboPriCity_Click", 13
                cboPriProvince.Text = dtcProvince.Recordset.Fields("ProvinceName")
  VBCP_Update 56, "cboPriCity_Click", 14
            End If
            ' Sync dtcCountry
            strTarget = "CountryCode = '" & dtcCity.Recordset.Fields("CountryCode") & "'"
  VBCP_Update 56, "cboPriCity_Click", 15
            dtcCountry.Recordset.FindFirst strTarget
  VBCP_Update 56, "cboPriCity_Click", 16
            If Not dtcCountry.Recordset.NoMatch And VBCP_UpdateIf(56, "cboPriCity_Click", 17) Then
                dtcCountry.UpdateControls
  VBCP_Update 56, "cboPriCity_Click", 18
                cboPriCountry.Text = dtcCountry.Recordset.Fields("CountryName")
  VBCP_Update 56, "cboPriCity_Click", 19
            End If
        End If
    End If
    
End Sub

Private Sub cboPriCity_GotFocus()
  VBCP_Update 56, "cboPriCity_GotFocus", 1
    ' Show Province and Country
    txtSyncProvince.Visible = True
  VBCP_Update 56, "cboPriCity_GotFocus", 2
    txtSyncCountry.Visible = True
  VBCP_Update 56, "cboPriCity_GotFocus", 3
    txtSyncProvince.ZOrder
  VBCP_Update 56, "cboPriCity_GotFocus", 4
    txtSyncCountry.ZOrder
  VBCP_Update 56, "cboPriCity_GotFocus", 5
End Sub


Private Sub cboPriCity_LostFocus()
  VBCP_Update 56, "cboPriCity_LostFocus", 1
    ' Hide Province and Country
    txtSyncProvince.Visible = False
  VBCP_Update 56, "cboPriCity_LostFocus", 2
    txtSyncCountry.Visible = False
  VBCP_Update 56, "cboPriCity_LostFocus", 3

End Sub


Private Sub datSupplier_Reposition()
  VBCP_Update 56, "datSupplier_Reposition", 1
            
    Dim strTarget As String
    If Not (datSupplier.Recordset.EOF Or datSupplier.Recordset.BOF) And VBCP_UpdateIf(56, "datSupplier_Reposition", 2) Then
        If datSupplier.Recordset!City <> "" And VBCP_UpdateIf(56, "datSupplier_Reposition", 3) Then
            ' Sync dtcCity
            strTarget = "Code = " & datSupplier.Recordset!City
  VBCP_Update 56, "datSupplier_Reposition", 4
            dtcCity.Recordset.FindFirst strTarget
  VBCP_Update 56, "datSupplier_Reposition", 5
            If Not dtcCity.Recordset.NoMatch Then _
