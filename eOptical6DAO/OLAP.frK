Attribute VB_Name = "frmOLAP"
Attribute VB_Creatable = False
Attribute VB_Exposed = False
Option Explicit

Private iTop As Integer
Private iLeft As Integer


Private Sub Form_Load()
    Left = (Screen.Width - Width) / 2   ' Center form horizontally.
    Top = (Screen.Height - Height) / 2  ' Center form vertically.
End Sub

Private Sub Form_Unload(Cancel As Integer)
    Unload Me
End Sub


Private Sub imgLogo_Click()
    frmAbout.Show 1
End Sub

Private Sub lblButton_Click(Index As Integer)
Select Case Index
    Case 0: frmSales.Show
    Case 1: frmMargin.Show
    Case 2: frmOrderInProgress.Show
    Case 3:                         'frmStock.Show
    Case 4: frmWizard.Show vbModal  ' frmPlay.Show
    Case 5: frmAbout.Show vbModal
    Case 6: Unload Me: End
End Select
End Sub


Private Sub lblButton_MouseDown(Index As Integer, Button As Integer, Shift As Integer, X As Single, Y As Single)
    iTop = lblButton(Index).Top
    iLeft = lblButton(Index).Left
    lblButton(Index).Move lblShadow(Index).Left, lblShadow(Index).Top
End Sub

Private Sub lblButton_MouseUp(Index As Integer, Button As Integer, Shift As Integer, X As Single, Y As Single)
    lblButton(Index).Move iLeft, iTop
End Sub


Private Sub lblDesc_Click(Index As Integer)
Select Case Index
    Case 0: frmSales.Show
    Case 1: frmMargin.Show
    Case 2: frmOrderInProgress.Show
    Case 3:                         ' frmStock.Show
    Case 4: frmWizard.Show vbModal  ' frmPlay.Show
    Case 5: frmAbout.Show vbModal
    Case 6: Unload Me: End
    End Select
End Sub

