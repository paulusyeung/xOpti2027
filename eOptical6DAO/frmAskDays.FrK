VERSION 4.00
Begin VB.Form frmAskDays 
   BorderStyle     =   3  'Fixed Dialog
   Caption         =   "General Ask Days"
   ClientHeight    =   2955
   ClientLeft      =   2160
   ClientTop       =   1455
   ClientWidth     =   7095
   Height          =   3360
   Left            =   2100
   LinkTopic       =   "Form1"
   LockControls    =   -1  'True
   MaxButton       =   0   'False
   MinButton       =   0   'False
   ScaleHeight     =   2955
   ScaleWidth      =   7095
   ShowInTaskbar   =   0   'False
   Top             =   1110
   Width           =   7215
   Begin VB.CommandButton cmdPrnSetup 
      Caption         =   "&Setup"
      Height          =   330
      Left            =   5280
      TabIndex        =   5
      Top             =   1920
      Width           =   1200
   End
   Begin VB.CommandButton cmdExit 
      Caption         =   "&Exit"
      Height          =   330
      Left            =   3480
      TabIndex        =   3
      Top             =   1920
      Width           =   1200
   End
   Begin VB.CommandButton cmdReset 
      Caption         =   "&Reset"
      Height          =   330
      Left            =   2040
      TabIndex        =   2
      Top             =   1920
      Width           =   1200
   End
   Begin VB.CommandButton cmdOK 
      Caption         =   "&OK "
      Height          =   330
      Left            =   600
      TabIndex        =   1
      Top             =   1920
      Width           =   1200
   End
   Begin VB.Frame Frame3 
      Caption         =   "Printer "
      Height          =   735
      Left            =   5160
      TabIndex        =   6
      Top             =   1680
      Width           =   1455
   End
   Begin VB.Frame Frame2 
      Caption         =   "Command"
      Height          =   735
      Left            =   480
      TabIndex        =   4
      Top             =   1680
      Width           =   4335
   End
   Begin VB.Frame Frame1 
      Caption         =   "Period of Days"
      Height          =   975
      Left            =   480
      TabIndex        =   7
      Top             =   360
      Width           =   6135
      Begin VB.TextBox txtDays 
         Height          =   330
         Left            =   3300
         TabIndex        =   0
         Text            =   "30"
         Top             =   360
         Width           =   800
      End
      Begin VB.Label Label1 
         Caption         =   "Enter required period of days:"
         Height          =   255
         Left            =   1080
         TabIndex        =   8
         Top             =   360
         Width           =   2775
      End
   End
   Begin VB.Label Label2 
      Caption         =   "Enter days in between today for printing the report:"
      Height          =   330
      Left            =   600
      TabIndex        =   9
      Top             =   960
      Width           =   3735
   End
End
Attribute VB_Name = "frmAskDays"
Attribute VB_Creatable = False
Attribute VB_Exposed = False



Private Sub cmdExit_Click()
    On Error GoTo cmdExit_Click_Err
    Unload Me
cmdExit_Click_Exit:         ' SDVB autocode
    On Error Resume Next    ' SDVB autocode
    Exit Sub                ' SDVB autocode
cmdExit_Click_Err:          ' SDVB autocode
    MsgBox Error            ' SDVB autocode
    Resume cmdExit_Click_Exit
End Sub

Private Sub cmdPrnSetup_Click()

    On Error GoTo cmdPrnSetup_Click_Err

    frmCtlCrw.CommonDialog1.Flags = &H40  'force the printers setup dialog box
    frmCtlCrw.CommonDialog1.Action = 5    'run the printer setup

cmdPrnSetup_Click_Exit:   ' SDVB autocode
    On Error Resume Next  ' SDVB autocode
    Exit Sub              ' SDVB autocode
cmdPrnSetup_Click_Err:    ' SDVB autocode
    MsgBox Error          ' SDVB autocode
    Resume cmdPrnSetup_Click_Exit

End Sub




Private Sub cmdOK_Click()

    On Error GoTo cmdOK_Click_Err
   
   Screen.MousePointer = 13
   ' check range of me.txtdays
    If InRange(Me.txtDays, "Days", 180, 1, True) Then
        frmCtlCrw.CrystalReport1.Formulas(0) = "AskDays =" & Me.txtDays
        'MsgBox frmCtlCrw.crystalReport1.SelectionFormula
        Screen.MousePointer = 11
        frmCtlCrw.CrystalReport1.Action = 1
        Screen.MousePointer = 0
    Else
        Call cmdReset_Click
    End If

cmdOK_Click_Exit:         ' SDVB autocode
    On Error Resume Next  ' SDVB autocode
    Exit Sub              ' SDVB autocode
cmdOK_Click_Err:          ' SDVB autocode
    Screen.MousePointer = 0
    MsgBox Error          ' SDVB autocode
    Resume cmdOK_Click_Exit

End Sub


Private Sub cmdReset_Click()

    On Error GoTo cmdReset_Click_Err
  
    Me.txtDays = 30
    Me.txtDays.SetFocus

cmdReset_Click_Exit:      ' SDVB autocode
    On Error Resume Next  ' SDVB autocode
    Exit Sub              ' SDVB autocode
cmdReset_Click_Err:       ' SDVB autocode
    MsgBox Error          ' SDVB autocode
    Resume cmdReset_Click_Exit

End Sub

Private Sub Form_Load()

    On Error GoTo Form_Load_Err
  
    Screen.MousePointer = 0
    Left = (Screen.Width - Width) / 2   ' Center form horizontally.
    Top = (Screen.Height - Height) / 2  ' Center form vertically.
    
    Me.Caption = CrwRptName

Form_Load_Exit:           ' SDVB autocode
    On Error Resume Next  ' SDVB autocode
    Exit Sub              ' SDVB autocode
Form_Load_Err:            ' SDVB autocode
    MsgBox Error          ' SDVB autocode
    Resume Form_Load_Exit

End Sub








Private Sub txtDays_Click()
    SendKeys "{home}+{end}", True
End Sub

Private Sub txtDays_GotFocus()

    On Error GoTo txtDays_GotFocus_Err
   
    SendKeys "{home}+{end}", True

txtDays_GotFocus_Exit:    ' SDVB autocode
    On Error Resume Next  ' SDVB autocode
    Exit Sub              ' SDVB autocode
txtDays_GotFocus_Err:     ' SDVB autocode
    MsgBox Error          ' SDVB autocode
    Resume txtDays_GotFocus_Exit

End Sub

Private Sub txtDays_KeyPress(KeyAscii As Integer)

    On Error GoTo txtDays_KeyPress_Err

    KeyAscii = KeyNumbers(KeyAscii)

txtDays_KeyPress_Exit:    ' SDVB autocode
    On Error Resume Next  ' SDVB autocode
    Exit Sub              ' SDVB autocode
txtDays_KeyPress_Err:     ' SDVB autocode
    MsgBox Error          ' SDVB autocode
    Resume txtDays_KeyPress_Exit

End Sub


