Attribute VB_Name = "frmDoctor"
Attribute VB_Creatable = False
Attribute VB_Exposed = False

Private Sub cmdSortByDrName_Click(Value As Integer)
  VBCP_Update 97, "cmdSortByDrName_Click", 1

    Dim strSQL As String
    
    If cmdSortByDrName.Value And VBCP_UpdateIf(97, "cmdSortByDrName_Click", 2) Then
        strSQL = "SELECT * FROM Doctor ORDER BY DoctorName ASC"
  VBCP_Update 97, "cmdSortByDrName_Click", 3
    Else
        strSQL = "SELECT * FROM Doctor ORDER BY DoctorName DESC"
  VBCP_Update 97, "cmdSortByDrName_Click", 4
    End If
    dtcDoctor.RecordSource = strSQL
  VBCP_Update 97, "cmdSortByDrName_Click", 5
    dtcDoctor.Refresh
  VBCP_Update 97, "cmdSortByDrName_Click", 6
    dtcDoctor.UpdateControls
  VBCP_Update 97, "cmdSortByDrName_Click", 7

End Sub

Private Sub cmdSortByPhone_Click(Value As Integer)
  VBCP_Update 97, "cmdSortByPhone_Click", 1

    Dim strSQL As String
    
    If cmdSortByPhone.Value And VBCP_UpdateIf(97, "cmdSortByPhone_Click", 2) Then
        strSQL = "SELECT * FROM Doctor ORDER BY Phone ASC"
  VBCP_Update 97, "cmdSortByPhone_Click", 3
    Else
        strSQL = "SELECT * FROM Doctor ORDER BY Phone DESC"
  VBCP_Update 97, "cmdSortByPhone_Click", 4
    End If
    dtcDoctor.RecordSource = strSQL
  VBCP_Update 97, "cmdSortByPhone_Click", 5
    dtcDoctor.Refresh
  VBCP_Update 97, "cmdSortByPhone_Click", 6
    dtcDoctor.UpdateControls
  VBCP_Update 97, "cmdSortByPhone_Click", 7

End Sub


Private Sub dbcCity_Click(intArea As Integer)
  VBCP_Update 97, "dbcCity_Click", 1

    Dim strTarget As String
    
    If intArea = dbcAreaList And VBCP_UpdateIf(97, "dbcCity_Click", 2) Then
        ' Sync dtcCity
        strTarget = "Code = " & dbcCity.BoundText
  VBCP_Update 97, "dbcCity_Click", 3
        dtcSelCity.Recordset.FindFirst strTarget
  VBCP_Update 97, "dbcCity_Click", 4
        If Not dtcSelCity.Recordset.NoMatch And VBCP_UpdateIf(97, "dbcCity_Click", 5) Then
            dtcSelCity.UpdateControls
  VBCP_Update 97, "dbcCity_Click", 6
            ' Fill Supplier fields: Province and Country
            If Not (dtcDoctor.Recordset.EditMode = dbEditAdd) And VBCP_UpdateIf(97, "dbcCity_Click", 7) Then dtcDoctor.Recordset.Edit
            dtcDoctor.Recordset!Province = dtcSelCity.Recordset!ProvinceCode
  VBCP_Update 97, "dbcCity_Click", 8
            dtcDoctor.Recordset!Country = dtcSelCity.Recordset!CountryCode
  VBCP_Update 97, "dbcCity_Click", 9
        End If
    End If

End Sub

Private Sub dbcCity_GotFocus()
  VBCP_Update 97, "dbcCity_GotFocus", 1
    ' Show Province and Country
    txtSyncProvince.Visible = True
  VBCP_Update 97, "dbcCity_GotFocus", 2
    txtSyncCountry.Visible = True
  VBCP_Update 97, "dbcCity_GotFocus", 3
    txtSyncProvince.ZOrder
  VBCP_Update 97, "dbcCity_GotFocus", 4
    txtSyncCountry.ZOrder
  VBCP_Update 97, "dbcCity_GotFocus", 5

End Sub


Private Sub dbcCity_LostFocus()
  VBCP_Update 97, "dbcCity_LostFocus", 1
    ' Hide Province and Country
    txtSyncProvince.Visible = False
  VBCP_Update 97, "dbcCity_LostFocus", 2
    txtSyncCountry.Visible = False
  VBCP_Update 97, "dbcCity_LostFocus", 3

End Sub

Private Sub dtcDoctor_Reposition()
  VBCP_Update 97, "dtcDoctor_Reposition", 1

    Dim strTarget As String
    
    ' Synconize the related tables
    If Not (dtcDoctor.Recordset.EOF Or dtcDoctor.Recordset.BOF) And VBCP_UpdateIf(97, "dtcDoctor_Reposition", 2) Then
        If dtcDoctor.Recordset!City <> "" And VBCP_UpdateIf(97, "dtcDoctor_Reposition", 3) Then
            ' Sync dtcCity
            strTarget = "Code = " & dtcDoctor.Recordset!City
  VBCP_Update 97, "dtcDoctor_Reposition", 4
            dtcSelCity.Recordset.FindFirst strTarget
  VBCP_Update 97, "dtcDoctor_Reposition", 5
            If Not dtcSelCity.Recordset.NoMatch Then _
