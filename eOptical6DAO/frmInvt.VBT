Private Sub mskLeastSellingPrice_Change()
  VBCP_Update 89, "mskLeastSellingPrice_Change", 1

    If Not IsDecimal(mskLeastSellingPrice, 2, True) Or _
       Not IsPositive(mskLeastSellingPrice, True) And VBCP_UpdateIf(89, "mskLeastSellingPrice_Change", 2) Then
        mskLeastSellingPrice.SetFocus
    End If

End Sub

Private Sub mskLeastSellingPrice_GotFocus()
  VBCP_Update 89, "mskLeastSellingPrice_GotFocus", 1
    Call AutoSelect(mskLeastSellingPrice)
  VBCP_Update 89, "mskLeastSellingPrice_GotFocus", 2
End Sub

Private Sub mskLeastSellingPrice_LostFocus()
  VBCP_Update 89, "mskLeastSellingPrice_LostFocus", 1

    If ofx_CCur(mskLeastSellingPrice.Text) = 0 And VBCP_UpdateIf(89, "mskLeastSellingPrice_LostFocus", 2) Then Exit Sub  ' Ignor Zero Null ""
    If Not IsDecimal(mskLeastSellingPrice, 2, True) Or _
       Not IsPositive(mskLeastSellingPrice, True) Or _
       Not IsA_LT_B(mskLeastSellingPrice, mskRetailPrice, True) And VBCP_UpdateIf(89, "mskLeastSellingPrice_LostFocus", 3) Then
        mskLeastSellingPrice.SetFocus
    End If

End Sub

Private Sub mskMarkdown_Change()
  VBCP_Update 89, "mskMarkdown_Change", 1

    If Not IsDecimal(mskMarkdown, 2, True) Or _
       Not IsPositive(mskMarkdown, True) And VBCP_UpdateIf(89, "mskMarkdown_Change", 2) Then
        mskMarkdown.SetFocus
    End If

End Sub

Private Sub mskMarkdown_GotFocus()
  VBCP_Update 89, "mskMarkdown_GotFocus", 1
    Call AutoSelect(mskMarkdown)
  VBCP_Update 89, "mskMarkdown_GotFocus", 2
    
End Sub

Private Sub mskMarkdown_LostFocus()
  VBCP_Update 89, "mskMarkdown_LostFocus", 1

    If ofx_CCur(mskMarkdown.Text) = 0 And VBCP_UpdateIf(89, "mskMarkdown_LostFocus", 2) Then Exit Sub  ' Ignor Zero Null ""
    If Not IsDecimal(mskMarkdown, 2, True) Or _
       Not IsPositive(mskMarkdown, True) Or _
       Not IsA_LE_BMinusC(mskMarkdown, mskRetailPrice, mskLeastSellingPrice, True) And VBCP_UpdateIf(89, "mskMarkdown_LostFocus", 3) Then
        mskMarkdown.SetFocus
    End If

End Sub

