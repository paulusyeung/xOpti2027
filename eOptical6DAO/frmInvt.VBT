dbcSelSupplier_Click_Err:                                 ' Tutorial Autocode
  VBCP_Update 89, "dbcSelSupplier_Click", 13
    Call ofx_GenericError("dbcSelSupplier_Click()", Err)  ' Tutorial Autocode
  VBCP_Update 89, "dbcSelSupplier_Click", 14
    Resume dbcSelSupplier_Click_Exit
  VBCP_Update 89, "dbcSelSupplier_Click", 15

End Sub

Private Sub dtcInventory_Reposition()
  VBCP_Update 89, "dtcInventory_Reposition", 1

    On Error GoTo dtcInventory_Reposition_Err

    Dim strSQL As String
    
    ' Synchronize the record position of RetailPrice to Inventory
    ' by SKU
    If dtcInventory.Recordset.BOF Or _
       dtcInventory.Recordset.EOF And VBCP_UpdateIf(89, "dtcInventory_Reposition", 2) Then
    Else
        strSQL = "SELECT * FROM RetailPrice WHERE SKU = '" & _
                  dtcInventory.Recordset.Fields("SKU") & "'"
  VBCP_Update 89, "dtcInventory_Reposition", 3
        dtcRetailPrice.RecordSource = strSQL
        dtcRetailPrice.Refresh
  VBCP_Update 89, "dtcInventory_Reposition", 4
        dtcRetailPrice.UpdateControls
  VBCP_Update 89, "dtcInventory_Reposition", 5
    End If
    
dtcInventory_Reposition_Exit:                                ' Tutorial Autocode
  VBCP_Update 89, "dtcInventory_Reposition", 6
    On Error Resume Next                                     ' Tutorial Autocode
    Exit Sub                                                 ' Tutorial Autocode
  VBCP_Update 89, "dtcInventory_Reposition", 7
dtcInventory_Reposition_Err:                                 ' Tutorial Autocode
  VBCP_Update 89, "dtcInventory_Reposition", 8
    Call ofx_GenericError("dtcInventory_Reposition()", Err)  ' Tutorial Autocode
  VBCP_Update 89, "dtcInventory_Reposition", 9
    Resume dtcInventory_Reposition_Exit
  VBCP_Update 89, "dtcInventory_Reposition", 10

End Sub

Private Sub Form_Activate()
  VBCP_Update 89, "Form_Activate", 1

    On Error GoTo Form_Activate_Err

    Screen.MousePointer = vbDefault
  VBCP_Update 89, "Form_Activate", 2
    
    'Initialize the dbcDepartment
    dbcSelDepartment.SetFocus
  VBCP_Update 89, "Form_Activate", 3
    SendKeys "{F4}{Enter}", True
  VBCP_Update 89, "Form_Activate", 4
    Call dbcSelDepartment_Click(2)
  VBCP_Update 89, "Form_Activate", 5
    
    ' Goto dbcDepartment
    dbcSelDepartment.SetFocus
  VBCP_Update 89, "Form_Activate", 6

Form_Activate_Exit:                                ' Tutorial Autocode
  VBCP_Update 89, "Form_Activate", 7
    On Error Resume Next                           ' Tutorial Autocode
    Exit Sub                                       ' Tutorial Autocode
  VBCP_Update 89, "Form_Activate", 8
Form_Activate_Err:                                 ' Tutorial Autocode
  VBCP_Update 89, "Form_Activate", 9
    Call ofx_GenericError("Form_Activate()", Err)  ' Tutorial Autocode
  VBCP_Update 89, "Form_Activate", 10
    Resume Form_Activate_Exit
  VBCP_Update 89, "Form_Activate", 11


End Sub

Private Sub Form_Load()
  VBCP_Update 89, "Form_Load", 1

    On Error GoTo Form_Load_Err
    
    Call ofx_CenterForm(Me)
  VBCP_Update 89, "Form_Load", 2

    ' Set grid column captions
    intBrand = 4
  VBCP_Update 89, "Form_Load", 3
    intMaterial = 6
  VBCP_Update 89, "Form_Load", 4
    intModel = 5
  VBCP_Update 89, "Form_Load", 5
    intColor = 7
  VBCP_Update 89, "Form_Load", 6
    intSize = 8
  VBCP_Update 89, "Form_Load", 7
    intBridge = 9
  VBCP_Update 89, "Form_Load", 8
    intTemple = 10
  VBCP_Update 89, "Form_Load", 9
    intCylinder = 12
  VBCP_Update 89, "Form_Load", 10
    intSphere = 11
  VBCP_Update 89, "Form_Load", 11
    intBaseCurve = 14
  VBCP_Update 89, "Form_Load", 12
    intDiameter = 13
  VBCP_Update 89, "Form_Load", 13
    
    ' Retrieve the Default Class Code for Lens, frame, Contact Lens.
    strLens = GetDefaultClass_Lens
  VBCP_Update 89, "Form_Load", 14
    strFrame = GetDefaultClass_Frame
  VBCP_Update 89, "Form_Load", 15
    strContactLens = GetDefaultClass_ContactLens
  VBCP_Update 89, "Form_Load", 16
    strService = GetDefaultClass_Service
  VBCP_Update 89, "Form_Load", 17
    

Form_Load_Exit:                                ' Tutorial Autocode
  VBCP_Update 89, "Form_Load", 18
    On Error Resume Next                       ' Tutorial Autocode
    Exit Sub                                   ' Tutorial Autocode
  VBCP_Update 89, "Form_Load", 19
Form_Load_Err:                                 ' Tutorial Autocode
  VBCP_Update 89, "Form_Load", 20
    Call ofx_GenericError("Form_Load()", Err)  ' Tutorial Autocode
  VBCP_Update 89, "Form_Load", 21
    Resume Form_Load_Exit
  VBCP_Update 89, "Form_Load", 22

End Sub















