Private Sub dbcClass_Click(intArea As Integer)
  VBCP_Update 89, "dbcClass_Click", 1

    On Error GoTo dbcClass_Click_Err

    If intArea = dbcAreaList And VBCP_UpdateIf(89, "dbcClass_Click", 2) Then
        ' RePaint input screen
        Select Case dbcClass.BoundText
        Case Is = strFrame
  VBCP_Update 89, "dbcClass_Click", 3
            Call Mode_Frame
  VBCP_Update 89, "dbcClass_Click", 4
        Case Is = strLens
  VBCP_Update 89, "dbcClass_Click", 5
            Call Mode_Lens
  VBCP_Update 89, "dbcClass_Click", 6
        Case Is = strContactLens
  VBCP_Update 89, "dbcClass_Click", 7
            Call Mode_ContactLens
  VBCP_Update 89, "dbcClass_Click", 8
        Case Is = strService
  VBCP_Update 89, "dbcClass_Click", 9
            Call Mode_Service
  VBCP_Update 89, "dbcClass_Click", 10
        Case Else
  VBCP_Update 89, "dbcClass_Click", 11
            Call Mode_Else
  VBCP_Update 89, "dbcClass_Click", 12
        End Select
        
        ' When Class was selected,
        ' Category DBCombo contains only those with the same Class Code, Dept Code
        Dim strSQL As String
        strSQL = "SELECT * FROM Category " _
            & "WHERE DepartmentCode = '" & dbcDepartment.BoundText & "' AND " _
            & "ClassCode = '" & dbcClass.BoundText & "' " _
            & "ORDER BY CategoryName"
  VBCP_Update 89, "dbcClass_Click", 13
        dtcCategory.RecordSource = strSQL
        dtcCategory.Refresh
  VBCP_Update 89, "dbcClass_Click", 14
        dtcCategory.UpdateControls
  VBCP_Update 89, "dbcClass_Click", 15
    End If

dbcClass_Click_Exit:                                ' Tutorial Autocode
  VBCP_Update 89, "dbcClass_Click", 16
    On Error Resume Next                            ' Tutorial Autocode
    Exit Sub                                        ' Tutorial Autocode
  VBCP_Update 89, "dbcClass_Click", 17
dbcClass_Click_Err:                                 ' Tutorial Autocode
  VBCP_Update 89, "dbcClass_Click", 18
    Call ofx_GenericError("dbcClass_Click()", Err)  ' Tutorial Autocode
  VBCP_Update 89, "dbcClass_Click", 19
    Resume dbcClass_Click_Exit
  VBCP_Update 89, "dbcClass_Click", 20

End Sub

Private Sub dbcDepartment_Change()
  VBCP_Update 89, "dbcDepartment_Change", 1
    ' When Dept was selected,
    ' Class DBCombo contains only those with the same Dept Code
        Dim strSQL As String
        strSQL = "SELECT * FROM Class " _
            & "WHERE Department = '" & dbcDepartment.BoundText & "' " _
            & "ORDER BY ClassName"
  VBCP_Update 89, "dbcDepartment_Change", 2
        dtcClass.RecordSource = strSQL
        dtcClass.Refresh
  VBCP_Update 89, "dbcDepartment_Change", 3
        dtcClass.UpdateControls
  VBCP_Update 89, "dbcDepartment_Change", 4

End Sub

Private Sub dbcDepartment_Click(intArea As Integer)
  VBCP_Update 89, "dbcDepartment_Click", 1
    ' When Dept was selected,
    ' Class DBCombo contains only those with the same Dept Code
    If intArea = dbcAreaList And VBCP_UpdateIf(89, "dbcDepartment_Click", 2) Then
        Dim strSQL As String
        strSQL = "SELECT * FROM Class " _
            & "WHERE Department = '" & dbcDepartment.BoundText & "' " _
            & "ORDER BY ClassName"
  VBCP_Update 89, "dbcDepartment_Click", 3
        dtcClass.RecordSource = strSQL
        dtcClass.Refresh
  VBCP_Update 89, "dbcDepartment_Click", 4
        dtcClass.UpdateControls
  VBCP_Update 89, "dbcDepartment_Click", 5
    End If

End Sub

Private Sub dbcSelBrand_Click(intArea As Integer)
  VBCP_Update 89, "dbcSelBrand_Click", 1

    On Error GoTo dbcSelBrand_Click_Err


    If intArea = dbcAreaList And VBCP_UpdateIf(89, "dbcSelBrand_Click", 2) Then
        dbcSelDepartment.Text = ""  ' Set selected department to null
  VBCP_Update 89, "dbcSelBrand_Click", 3
        dbcSelClass.Text = ""       ' Set selected class to null
  VBCP_Update 89, "dbcSelBrand_Click", 4
        dbcSelCategory.Text = ""    ' Set selected category to null
  VBCP_Update 89, "dbcSelBrand_Click", 5
        dbcSelSupplier.Text = ""    ' Set selected supplier to null
  VBCP_Update 89, "dbcSelBrand_Click", 6
        Dim strSQL As String
        strSQL = "SELECT * FROM Inventory " _
            & "WHERE BrandCode = '" & dbcSelBrand.BoundText & "' " _
            & "ORDER BY DepartmentCode, ClassCode, CategoryCode"
  VBCP_Update 89, "dbcSelBrand_Click", 7
        dtcInventory.RecordSource = strSQL
        dtcInventory.Refresh
  VBCP_Update 89, "dbcSelBrand_Click", 8
        dtcInventory.UpdateControls
  VBCP_Update 89, "dbcSelBrand_Click", 9
        
        ' RePaint the grid
        Call Mode_Standard
  VBCP_Update 89, "dbcSelBrand_Click", 10
    End If


dbcSelBrand_Click_Exit:                                ' Tutorial Autocode
  VBCP_Update 89, "dbcSelBrand_Click", 11
    On Error Resume Next                               ' Tutorial Autocode
    Exit Sub                                           ' Tutorial Autocode
  VBCP_Update 89, "dbcSelBrand_Click", 12
dbcSelBrand_Click_Err:                                 ' Tutorial Autocode
  VBCP_Update 89, "dbcSelBrand_Click", 13
    Call ofx_GenericError("dbcSelBrand_Click()", Err)  ' Tutorial Autocode
  VBCP_Update 89, "dbcSelBrand_Click", 14
    Resume dbcSelBrand_Click_Exit
  VBCP_Update 89, "dbcSelBrand_Click", 15

End Sub

Private Sub dbcSelCategory_Click(intArea As Integer)
  VBCP_Update 89, "dbcSelCategory_Click", 1

    On Error GoTo dbcSelCategory_Click_Err

    If intArea = dbcAreaList And VBCP_UpdateIf(89, "dbcSelCategory_Click", 2) Then
        dbcSelSupplier.Text = ""    ' Set selected supplier to null
  VBCP_Update 89, "dbcSelCategory_Click", 3
        dbcSelBrand.Text = ""       ' Set selected brand to null
  VBCP_Update 89, "dbcSelCategory_Click", 4
        Dim strSQL As String
        strSQL = "SELECT * FROM Inventory " _
            & "WHERE DepartmentCode = '" & dbcSelDepartment.BoundText & "' AND " _
                  & "ClassCode = '" & dbcSelClass.BoundText & "' AND " _
                  & "CategoryCode = '" & dbcSelCategory.BoundText & "' " _
            & "ORDER BY DepartmentCode, ClassCode, CategoryCode"
  VBCP_Update 89, "dbcSelCategory_Click", 5
        dtcInventory.RecordSource = strSQL
        dtcInventory.Refresh
  VBCP_Update 89, "dbcSelCategory_Click", 6
        dtcInventory.UpdateControls
  VBCP_Update 89, "dbcSelCategory_Click", 7
    End If

dbcSelCategory_Click_Exit:                                ' Tutorial Autocode
  VBCP_Update 89, "dbcSelCategory_Click", 8
    On Error Resume Next                                 ' Tutorial Autocode
    Exit Sub                                             ' Tutorial Autocode
  VBCP_Update 89, "dbcSelCategory_Click", 9
dbcSelCategory_Click_Err:                                 ' Tutorial Autocode
  VBCP_Update 89, "dbcSelCategory_Click", 10
    Call ofx_GenericError("dbcSelCategory_Click()", Err)  ' Tutorial Autocode
  VBCP_Update 89, "dbcSelCategory_Click", 11
    Resume dbcSelCategory_Click_Exit
  VBCP_Update 89, "dbcSelCategory_Click", 12

End Sub

Private Sub dbcSelClass_Click(intArea As Integer)
  VBCP_Update 89, "dbcSelClass_Click", 1

    On Error GoTo dbcSelClass_Click_Err

    If intArea = dbcAreaList And VBCP_UpdateIf(89, "dbcSelClass_Click", 2) Then
        dbcSelCategory.Text = ""    ' Set selected category to null
  VBCP_Update 89, "dbcSelClass_Click", 3
        dbcSelSupplier.Text = ""    ' Set selected supplier to null
  VBCP_Update 89, "dbcSelClass_Click", 4
        dbcSelBrand.Text = ""       ' Set selected brand to null
  VBCP_Update 89, "dbcSelClass_Click", 5
        Dim strSQL As String
        ' Sync Category DAO with SelDepartment & SelClass
        strSQL = "SELECT * FROM Category " _
            & "WHERE DepartmentCode = '" & dbcSelDepartment.BoundText & "' AND " _
            & "ClassCode = '" & dbcSelClass.BoundText & "' " _
            & "ORDER BY CategoryName"
  VBCP_Update 89, "dbcSelClass_Click", 6
        dtcCategory.RecordSource = strSQL
        dtcCategory.Refresh
  VBCP_Update 89, "dbcSelClass_Click", 7
        dtcCategory.UpdateControls
  VBCP_Update 89, "dbcSelClass_Click", 8
        ' Sync Inventory DAO Contents
        strSQL = "SELECT * FROM Inventory " _
            & "WHERE DepartmentCode = '" & dbcSelDepartment.BoundText & "' AND " _
                  & "ClassCode = '" & dbcSelClass.BoundText & "' " _
            & "ORDER BY DepartmentCode, ClassCode, CategoryCode"
  VBCP_Update 89, "dbcSelClass_Click", 9
        dtcInventory.RecordSource = strSQL
        dtcInventory.Refresh
  VBCP_Update 89, "dbcSelClass_Click", 10
        dtcInventory.UpdateControls
  VBCP_Update 89, "dbcSelClass_Click", 11
        
        Select Case dbcSelClass.BoundText
        Case Is = strFrame
  VBCP_Update 89, "dbcSelClass_Click", 12
            Call Mode_Frame
  VBCP_Update 89, "dbcSelClass_Click", 13
        Case Is = strLens
  VBCP_Update 89, "dbcSelClass_Click", 14
            Call Mode_Lens
  VBCP_Update 89, "dbcSelClass_Click", 15
        Case Is = strContactLens
  VBCP_Update 89, "dbcSelClass_Click", 16
            Call Mode_ContactLens
  VBCP_Update 89, "dbcSelClass_Click", 17
        Case Is = strService
  VBCP_Update 89, "dbcSelClass_Click", 18
            Call Mode_Service
  VBCP_Update 89, "dbcSelClass_Click", 19
        Case Else
  VBCP_Update 89, "dbcSelClass_Click", 20
            Call Mode_Else
  VBCP_Update 89, "dbcSelClass_Click", 21
        End Select
        
    End If

dbcSelClass_Click_Exit:                                ' Tutorial Autocode
  VBCP_Update 89, "dbcSelClass_Click", 22
    On Error Resume Next                                 ' Tutorial Autocode
    Exit Sub                                             ' Tutorial Autocode
  VBCP_Update 89, "dbcSelClass_Click", 23
dbcSelClass_Click_Err:                                 ' Tutorial Autocode
  VBCP_Update 89, "dbcSelClass_Click", 24
    Call ofx_GenericError("dbcSelClass_Click()", Err)  ' Tutorial Autocode
  VBCP_Update 89, "dbcSelClass_Click", 25
    Resume dbcSelClass_Click_Exit
  VBCP_Update 89, "dbcSelClass_Click", 26


End Sub

Private Sub dbcSelDepartment_Click(intArea As Integer)
  VBCP_Update 89, "dbcSelDepartment_Click", 1

    On Error GoTo dbcSelDepartment_Click_Err

    If intArea = dbcAreaList And VBCP_UpdateIf(89, "dbcSelDepartment_Click", 2) Then
        dbcSelClass.Text = ""       ' Set selected category to null
  VBCP_Update 89, "dbcSelDepartment_Click", 3
        dbcSelCategory.Text = ""    ' Set selected category to null
  VBCP_Update 89, "dbcSelDepartment_Click", 4
        dbcSelSupplier.Text = ""    ' Set selected supplier to null
  VBCP_Update 89, "dbcSelDepartment_Click", 5
        dbcSelBrand.Text = ""       ' Set selected brand to null
  VBCP_Update 89, "dbcSelDepartment_Click", 6
        Dim strSQL As String
        ' Sync Class DAO Contents with the same Dept Code
        strSQL = "SELECT * FROM Class " _
            & "WHERE Department = '" & dbcSelDepartment.BoundText & "' " _
            & "ORDER BY ClassName"
  VBCP_Update 89, "dbcSelDepartment_Click", 7
        dtcClass.RecordSource = strSQL
        dtcClass.Refresh
  VBCP_Update 89, "dbcSelDepartment_Click", 8
        dtcClass.UpdateControls
  VBCP_Update 89, "dbcSelDepartment_Click", 9
        ' Sync Inventory DAO Contents
        strSQL = "SELECT * FROM Inventory " _
            & "WHERE DepartmentCode = '" & dbcSelDepartment.BoundText & "' " _
            & "ORDER BY DepartmentCode, ClassCode, CategoryCode"
  VBCP_Update 89, "dbcSelDepartment_Click", 10
        dtcInventory.RecordSource = strSQL
        dtcInventory.Refresh
  VBCP_Update 89, "dbcSelDepartment_Click", 11
        dtcInventory.UpdateControls
  VBCP_Update 89, "dbcSelDepartment_Click", 12
        ' Skip this if dtcInventory has no record:
        If dtcInventory.Recordset.EOF And dtcInventory.Recordset.BOF And VBCP_UpdateIf(89, "dbcSelDepartment_Click", 13) Then
            strSQL = "SELECT * FROM RetailPrice " _
                & "WHERE SKU = ' '"
  VBCP_Update 89, "dbcSelDepartment_Click", 14
            dtcRetailPrice.RecordSource = strSQL
            dtcRetailPrice.Refresh
  VBCP_Update 89, "dbcSelDepartment_Click", 15
            dtcRetailPrice.UpdateControls
  VBCP_Update 89, "dbcSelDepartment_Click", 16
        End If
    End If

dbcSelDepartment_Click_Exit:                                ' Tutorial Autocode
  VBCP_Update 89, "dbcSelDepartment_Click", 17
    On Error Resume Next                                 ' Tutorial Autocode
    Exit Sub                                             ' Tutorial Autocode
  VBCP_Update 89, "dbcSelDepartment_Click", 18
dbcSelDepartment_Click_Err:                                 ' Tutorial Autocode
  VBCP_Update 89, "dbcSelDepartment_Click", 19
    Call ofx_GenericError("dbcSelDepartment_Click()", Err)  ' Tutorial Autocode
  VBCP_Update 89, "dbcSelDepartment_Click", 20
    Resume dbcSelDepartment_Click_Exit
  VBCP_Update 89, "dbcSelDepartment_Click", 21

End Sub

Private Sub dbcSelSupplier_Click(intArea As Integer)
  VBCP_Update 89, "dbcSelSupplier_Click", 1

    On Error GoTo dbcSelSupplier_Click_Err

    If intArea = dbcAreaList And VBCP_UpdateIf(89, "dbcSelSupplier_Click", 2) Then
        dbcSelDepartment.Text = ""  ' Set selected department to null
  VBCP_Update 89, "dbcSelSupplier_Click", 3
        dbcSelClass.Text = ""       ' Set selected class to null
  VBCP_Update 89, "dbcSelSupplier_Click", 4
        dbcSelCategory.Text = ""    ' Set selected category to null
  VBCP_Update 89, "dbcSelSupplier_Click", 5
        dbcSelBrand.Text = ""       ' Set selected brand to null
  VBCP_Update 89, "dbcSelSupplier_Click", 6
        Dim strSQL As String
        strSQL = "SELECT * FROM Inventory " _
            & "WHERE SupplierCode = '" & dbcSelSupplier.BoundText & "' " _
            & "ORDER BY DepartmentCode, ClassCode, CategoryCode"
  VBCP_Update 89, "dbcSelSupplier_Click", 7
        dtcInventory.RecordSource = strSQL
        dtcInventory.Refresh
  VBCP_Update 89, "dbcSelSupplier_Click", 8
