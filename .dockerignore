*
!xOpti.sln
!src
src/**/obj
src/**/bin
# Local settings can contain a connection string; never bake them into an image.
src/**/appsettings.Development.json
src/xOpti.Migrations
!eOptical6DAO
eOptical6DAO/*
!eOptical6DAO/3of9.TTF

# Web build inputs (node_modules and build output are excluded in the web project)
!web
web/xOpti.Web/node_modules
web/xOpti.Web/dist
web/xOpti.Web/public/vendor
!api-contract
!scripts
!docker

# Canonical schema rebuild script copied into the API image for --bootstrap/--schema-drift
!tools/legacy-migration/schema/xopti-schema.sql
