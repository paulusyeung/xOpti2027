  "components": {
    "schemas": {
      "BranchDto": {
        "required": [
          "branchCode",
          "name",
          "city"
        ],
        "type": "object",
        "properties": {
          "branchCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "city": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ChangeRoleRequest": {
        "required": [
          "role",
          "reason"
        ],
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "CompleteResetRequest": {
        "required": [
          "username",
          "token",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "CreateStaffRequest": {
        "required": [
          "userName",
          "displayName",
          "role",
          "branchCode",
          "reason"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "type": "string"
          },
          "branchCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "CurrentUserResponse": {
        "required": [
          "username",
          "displayName",
          "branch",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "branch": {
            "type": [
              "null",
              "string"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LevelRuleDto": {
        "required": [
          "minLevel",
          "role"
        ],
        "type": "object",
        "properties": {
          "minLevel": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "PagedResultOfBranchDto": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BranchDto"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PagedResultOfReferenceItemDto": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReferenceItemDto"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PagedResultOfStaffAccountDto": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StaffAccountDto"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PasswordResetCompletedDto": {
        "required": [
          "userName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          }
        }
      },
      "PermissionCatalogueDto": {
        "required": [
          "permissions",
          "unassignedPermissions"
        ],
        "type": "object",
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionGrantDto"
            }
          },
          "unassignedPermissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PermissionGrantDto": {
        "required": [
          "permission",
          "roles"
        ],
        "type": "object",
        "properties": {
          "permission": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ReasonRequest": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "ReferenceItemDto": {
        "required": [
          "kind",
          "key",
          "name"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parent": {
            "type": [
              "null",
              "string"
            ]
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ReferenceKind": {
        "type": "integer"
      },
      "ReferenceMutationRequest": {
        "required": [
          "key",
          "name",
          "parent",
          "summaryFlag",
          "costingMethod",
          "inventoryMethod",
          "taxMethod",
          "paymentNameShort",
          "exchangeRate",
          "reason"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parent": {
            "type": [
              "null",
              "string"
            ]
          },
          "summaryFlag": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "costingMethod": {
            "type": [
              "null",
              "string"
            ]
          },
          "inventoryMethod": {
            "type": [
              "null",
              "string"
            ]
          },
          "taxMethod": {
            "type": [
              "null",
              "string"
            ]
          },
          "paymentNameShort": {
            "type": [
              "null",
              "string"
            ]
          },
          "exchangeRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "RenameBranchRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "expectedCurrentName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RetireReferenceRequest": {
        "required": [
          "key",
          "reason",
          "confirmReferenced"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "confirmReferenced": {
            "type": "boolean"
          }
        }
      },
      "RoleCatalogueDto": {
        "required": [
          "version",
          "signed",
          "signedBy",
          "approvedOn",
          "levelRules",
          "roles",
          "unassignedPermissions",
          "parityGaps"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "signed": {
            "type": "boolean"
          },
          "signedBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "approvedOn": {
            "type": [
              "null",
              "string"
            ]
          },
          "levelRules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LevelRuleDto"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleGrantDto"
            }
          },
          "unassignedPermissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parityGaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RoleGrantDto": {
        "required": [
          "role",
